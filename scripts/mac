#!/usr/bin/env bash
#
# Drive the Mac build host from WSL2. See docs/adr/0010-the-mac-is-a-mirror-and-a-simulator.md
#
# The WSL2 tree is the only source of truth. Every verb rsyncs before it acts,
# so there is no sync verb and no way to run against a stale mirror.

set -euo pipefail

HOST="${FREEDOMFROM_MAC_HOST:-mac}"
ROOT="${FREEDOMFROM_MAC_ROOT:-builds/freedomfrom}"   # relative to the Mac's $HOME
SIM="${FREEDOMFROM_SIM:-iPhone 17 Pro}"
DEVICE="${FREEDOMFROM_DEVICE:-7EE3550E-8A48-5192-B729-961CB3FD51E9}"
SIGN_SOCKET="${FREEDOMFROM_SIGN_SOCKET:-$HOME/.ssh/cm/mac-sign}"

SCHEME=FreedomFrom
BUNDLE=com.samuelcolacchia.freedomfrom
SUBSYSTEM=com.samuelcolacchia.freedomfrom
KIT=FreedomFromKit

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Run a script on the Mac. The script arrives on stdin, so nothing is quoted twice.
remote() { ssh -o BatchMode=yes "$HOST" bash -s; }

# Run a script on the Mac through the socket a human unlocked for signing.
remote_signing() { ssh -o ControlPath="$SIGN_SOCKET" "$HOST" bash -s; }

sync_tree() {
  rsync -az --delete \
    --exclude '.git/' --exclude '.omo/' --exclude '.codegraph/' \
    --exclude '.build/' --exclude 'DerivedData/' \
    "$REPO/" "$HOST:$ROOT/src/"
}

cmd_build() {
  sync_tree
  remote <<EOF
set -euo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
R="\$HOME/$ROOT"; mkdir -p "\$R/derived" "\$R/logs"
cd "\$R/src"
xcodegen generate --quiet
set -o pipefail
xcodebuild -project $SCHEME.xcodeproj -scheme $SCHEME \\
  -destination 'platform=iOS Simulator,name=$SIM' \\
  -derivedDataPath "\$R/derived" build 2>&1 \\
  | tee "\$R/logs/build.log" | xcbeautify --quiet --disable-logging
EOF
}

cmd_test() {
  sync_tree
  remote <<EOF
set -euo pipefail
cd "\$HOME/$ROOT/src/$KIT"
swift test
EOF
}

cmd_run() {
  cmd_build
  remote <<EOF
set -euo pipefail
R="\$HOME/$ROOT"
xcrun simctl boot '$SIM' 2>/dev/null || true
xcrun simctl bootstatus '$SIM' >/dev/null
xcrun simctl install booted "\$R/derived/Build/Products/Debug-iphonesimulator/$SCHEME.app"
xcrun simctl launch booted $BUNDLE
sleep ${1:-3}
echo "--- $SUBSYSTEM ---"
xcrun simctl spawn booted log show --last 2m --style compact --info --debug \\
  --predicate 'subsystem == "$SUBSYSTEM"' 2>/dev/null | tail -n 60
EOF
}

cmd_log() {
  remote <<EOF
xcrun simctl spawn booted log show --last ${1:-5}m --style compact --info --debug \\
  --predicate 'subsystem == "$SUBSYSTEM"' 2>/dev/null | tail -n 200
EOF
}

cmd_rawlog() {
  remote <<EOF
tail -n ${1:-200} "\$HOME/$ROOT/logs/build.log"
EOF
}

cmd_clean() {
  remote <<EOF
R="\$HOME/$ROOT"
rm -rf "\$R/derived" "\$R/src/$SCHEME.xcodeproj" "\$R/src/$KIT/.build"
echo "cleaned \$R/derived and the generated project"
EOF
}

# A device build needs two things no agent can do for itself: a keychain
# unlocked by a person inside this very SSH session (issue #13), and a cabled
# phone. Both are probed in under a second, ahead of an archive that is minutes.
cmd_device() {
  if [[ ! -S "$SIGN_SOCKET" ]]; then
    cat >&2 <<EOF
No signing socket at $SIGN_SOCKET

A person at their own shell runs these. The password never enters this session:

  mkdir -p $(dirname "$SIGN_SOCKET")
  ssh -o ControlMaster=yes -o ControlPath=$SIGN_SOCKET -o ControlPersist=8h -fN $HOST
  read -rs pw && printf '%s\\n' "\$pw" | ssh -o ControlPath=$SIGN_SOCKET $HOST \\
    'read -r p; security unlock-keychain -p "\$p" ~/Library/Keychains/login.keychain-db'
EOF
    return 3
  fi

  if ! remote_signing <<'PROBE' >/dev/null 2>&1
d=$(mktemp -d) && cp /bin/echo "$d/probe" &&
  codesign --force --sign "Apple Development" "$d/probe"
rc=$?; rm -rf "$d"; exit $rc
PROBE
  then
    echo "The socket at $SIGN_SOCKET exists but cannot sign: its keychain was never unlocked. Remove the socket and re-run 'scripts/mac device' to get the unlock lines." >&2
    return 3
  fi

  if ! remote_signing <<EOF >/dev/null 2>&1
xcrun devicectl device info details --device $DEVICE
EOF
  then
    echo "Device $DEVICE is not reachable. Someone has to cable it to the Mac: issue #13 fixed that devices are plugged in only when installing." >&2
    return 4
  fi

  sync_tree
  remote_signing <<EOF
set -euo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
R="\$HOME/$ROOT"; mkdir -p "\$R/derived" "\$R/logs"
cd "\$R/src"
xcodegen generate --quiet
set -o pipefail
xcodebuild -project $SCHEME.xcodeproj -scheme $SCHEME \\
  -destination 'generic/platform=iOS' \\
  -archivePath "\$R/derived/$SCHEME.xcarchive" \\
  -allowProvisioningUpdates archive 2>&1 \\
  | tee "\$R/logs/device.log" | xcbeautify --quiet --disable-logging
xcrun devicectl device install app --device $DEVICE \\
  "\$R/derived/$SCHEME.xcarchive/Products/Applications/$SCHEME.app"
EOF
}

cmd_help() {
  cat <<EOF
scripts/mac VERB — run the build on $HOST. Every verb syncs first.

  build            compile for the '$SIM' simulator. No signing, no human.
  test             swift test on $KIT, against Darwin Foundation.
  run [secs]       build, launch on the simulator, print the app's own log lines.
  log [mins]       re-read those log lines without rebuilding.
  rawlog [lines]   tail the unfiltered xcodebuild log.
  device           sign and install on the phone. Needs a cable and a human-unlocked socket.
  clean            drop the derived-data cache and the generated project.

Overridable: FREEDOMFROM_MAC_HOST FREEDOMFROM_MAC_ROOT FREEDOMFROM_SIM
             FREEDOMFROM_DEVICE FREEDOMFROM_SIGN_SOCKET
EOF
}

case "${1:-help}" in
  build)  shift; cmd_build ;;
  test)   shift; cmd_test ;;
  run)    shift; cmd_run "$@" ;;
  log)    shift; cmd_log "$@" ;;
  rawlog) shift; cmd_rawlog "$@" ;;
  device) shift; cmd_device ;;
  clean)  shift; cmd_clean ;;
  help|-h|--help) cmd_help ;;
  *) echo "unknown verb: $1" >&2; echo >&2; cmd_help >&2; exit 2 ;;
esac
