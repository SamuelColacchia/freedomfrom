#!/usr/bin/env bash
#
# Drive the Mac build host from WSL2. See docs/adr/0010-the-mac-is-a-mirror-and-a-simulator.md
#
# The WSL2 tree is the only source of truth. Every verb rsyncs before it acts,
# so there is no sync verb and no way to run against a stale mirror.

set -euo pipefail

HOST="${FREEDOMFROM_MAC_HOST:-mac}"
ROOT="${FREEDOMFROM_MAC_ROOT:-builds/freedomfrom}"   # relative to the Mac's $HOME
SIM="${FREEDOMFROM_SIM:-iPhone 17 Pro}"
DEVICE="${FREEDOMFROM_DEVICE:-}"
MACBRIDGE="${FREEDOMFROM_MACBRIDGE:-mac}"   # ~/projects/macbridge; signs and installs on the phone

SCHEME=FreedomFrom
BUNDLE=com.samuelcolacchia.freedomfrom
SUBSYSTEM=com.samuelcolacchia.freedomfrom
KIT=FreedomFromKit

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The hardware pass commits and observes fifteen times, and the product offers
# no way out but the Screen Time revoke — which is itself check X1, and taking
# it repeatedly contaminates the clean run. Setting FREEDOMFROM_HARDWARE_PASS=1
# compiles in a release control that no other build can contain, because the
# condition is empty unless this variable puts it there.
PASS=""
[[ -n "${FREEDOMFROM_HARDWARE_PASS:-}" ]] && PASS="FREEDOMFROM_HARDWARE_PASS=HARDWARE_PASS"

# Said out loud, every time, because the variable outlives the session that set
# it. An exported FREEDOMFROM_HARDWARE_PASS from an earlier run silently put a
# release control on the phone and cost a fifteen-minute check its result: the
# wizards refuse to score such a build, but only after reading the archive,
# which is after the run is spent. This is the last moment it is still cheap.
announce_hardware_pass() {
  [[ -n "$PASS" ]] || return 0
  cat >&2 <<EOF

  ⚠  FREEDOMFROM_HARDWARE_PASS is set, so this build carries a release control.

     It announces itself on every launch, and no hardware check is scored from
     a build that has one — the product has no such action anywhere (ADR 0001).

     For a run you intend to score:  unset FREEDOMFROM_HARDWARE_PASS

EOF
}

# Run a script on the Mac. The script arrives on stdin, so nothing is quoted twice.
remote() { ssh -o BatchMode=yes "$HOST" bash -s; }

sync_tree() {
  rsync -az --delete \
    --exclude '.git/' --exclude '.omo/' --exclude '.codegraph/' \
    --exclude '.build/' --exclude 'DerivedData/' \
    "$REPO/" "$HOST:$ROOT/src/"
}

cmd_build() {
  announce_hardware_pass
  sync_tree
  remote <<EOF
set -euo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
R="\$HOME/$ROOT"; mkdir -p "\$R/derived" "\$R/logs"
cd "\$R/src"
xcodegen generate --quiet
set -o pipefail
xcodebuild -project $SCHEME.xcodeproj -scheme $SCHEME \\
  -destination 'platform=iOS Simulator,name=$SIM' \\
  -derivedDataPath "\$R/derived" $PASS build 2>&1 \\
  | tee "\$R/logs/build.log" | xcbeautify --quiet --disable-logging
EOF
}

cmd_test() {
  sync_tree
  remote <<EOF
set -euo pipefail
cd "\$HOME/$ROOT/src/$KIT"
swift test
EOF
}

# The only verb that touches the app the way a person does. `test` proves the
# kit's logic and `build` proves it compiles; neither presses anything, which is
# how two broken hold-to-confirm fixes shipped. This drives the simulator.
cmd_uitest() {
  sync_tree
  remote <<EOF
set -euo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
R="\$HOME/$ROOT"; mkdir -p "\$R/derived" "\$R/logs"
cd "\$R/src"
xcodegen generate --quiet
set -o pipefail
xcodebuild -project $SCHEME.xcodeproj -scheme $SCHEME \\
  -destination 'platform=iOS Simulator,name=$SIM' \\
  -derivedDataPath "\$R/derived" $PASS test 2>&1 \\
  | tee "\$R/logs/uitest.log" | xcbeautify --quiet --disable-logging
EOF
}

cmd_run() {
  announce_hardware_pass
  cmd_build
  remote <<EOF
set -euo pipefail
R="\$HOME/$ROOT"
xcrun simctl boot '$SIM' 2>/dev/null || true
xcrun simctl bootstatus '$SIM' >/dev/null
xcrun simctl install booted "\$R/derived/Build/Products/Debug-iphonesimulator/$SCHEME.app"
xcrun simctl launch booted $BUNDLE
sleep ${1:-3}
echo "--- $SUBSYSTEM ---"
xcrun simctl spawn booted log show --last 2m --style compact --info --debug \\
  --predicate 'subsystem == "$SUBSYSTEM"' 2>/dev/null | tail -n 60
EOF
}

# The app became a UI at work item 5, and until now nothing in the loop could
# look at one. A screenshot is as far as *simctl* goes: it can boot, install,
# launch and capture, but it cannot tap, so this reads the screen the app
# happens to be on rather than driving it there. Driving it is `uitest`.
cmd_shot() {
  local out="${1:-$REPO/shot.png}"
  remote <<EOF
set -euo pipefail
xcrun simctl io booted screenshot --type=png "\$HOME/$ROOT/logs/shot.png" >/dev/null 2>&1
EOF
  scp -q -o BatchMode=yes "$HOST:$ROOT/logs/shot.png" "$out"
  echo "$out"
}

cmd_log() {
  remote <<EOF
xcrun simctl spawn booted log show --last ${1:-5}m --style compact --info --debug \\
  --predicate 'subsystem == "$SUBSYSTEM"' 2>/dev/null | tail -n 200
EOF
}

cmd_rawlog() {
  remote <<EOF
tail -n ${1:-200} "\$HOME/$ROOT/logs/build.log"
EOF
}

cmd_clean() {
  remote <<EOF
R="\$HOME/$ROOT"
rm -rf "\$R/derived" "\$R/src/$SCHEME.xcodeproj" "\$R/src/$KIT/.build"
echo "cleaned \$R/derived and the generated project"
EOF
}

# Signing and installing go through macbridge (~/projects/macbridge): a
# dedicated keychain on the Mac plus the App Store Connect key, so a device
# build signs, provisions and installs with nobody at the Mac. This replaces
# issue #13's human-unlocked socket; see docs/adr/0011.
#
# The phone is chosen by macbridge, which matches FREEDOMFROM_DEVICE against
# the CoreDevice UUID, the hardware UDID or the name (Xcode 26 printed the
# first, Xcode 27 the second), and wakes an idle Wi-Fi phone rather than
# calling it absent. Unset, it takes the one phone there is.
cmd_device() {
  announce_hardware_pass
  if ! command -v "$MACBRIDGE" >/dev/null 2>&1; then
    echo "scripts/mac device needs macbridge's 'mac' on PATH (~/projects/macbridge, bin/mac)." >&2
    return 3
  fi
  local row
  row=$(MAC_HOST="$HOST" MAC_DEVICE="$DEVICE" "$MACBRIDGE" phone which) || return 4
  printf '  using %s (%s, iOS %s)\n' "$(cut -f2 <<<"$row")" "$(cut -f1 <<<"$row")" "$(cut -f3 <<<"$row")" >&2

  # Seconds, against an archive that is a minute: say now if signing is broken.
  if ! MAC_HOST="$HOST" "$MACBRIDGE" signing status >/dev/null; then
    echo "Unattended signing on $HOST is not working; 'mac signing status' says why." >&2
    return 3
  fi

  local pass=()
  [[ -n "$PASS" ]] && pass=("$PASS")
  MAC_HOST="$HOST" "$MACBRIDGE" xcb -C "$REPO" --sign -- \
    -project "$SCHEME.xcodeproj" -scheme "$SCHEME" \
    -destination 'generic/platform=iOS' \
    -archivePath "../derived/$SCHEME.xcarchive" \
    ${pass[@]+"${pass[@]}"} archive
  MAC_HOST="$HOST" MAC_DEVICE="$(cut -f1 <<<"$row")" "$MACBRIDGE" phone install \
    "$(basename "$REPO")/derived/$SCHEME.xcarchive/Products/Applications/$SCHEME.app"
}

cmd_help() {
  cat <<EOF
scripts/mac VERB — run the build on $HOST. Every verb syncs first.

  build            compile for the '$SIM' simulator. No signing, no human.
  test             swift test on $KIT, against Darwin Foundation.
  uitest           drive the app on the simulator. The only verb that presses anything.
  run [secs]       build, launch on the simulator, print the app's own log lines.
  shot [file]      capture what the simulator is showing right now.
  log [mins]       re-read those log lines without rebuilding.
  rawlog [lines]   tail the unfiltered xcodebuild log.
  device           archive, sign and install on the phone, unattended, through
                   macbridge. FREEDOMFROM_DEVICE picks when several are paired.
  clean            drop the derived-data cache and the generated project.

Set FREEDOMFROM_HARDWARE_PASS=1 to compile in a release control for the
hardware pass. The product has none; no build without this variable can.

Overridable: FREEDOMFROM_MAC_HOST FREEDOMFROM_MAC_ROOT FREEDOMFROM_SIM
             FREEDOMFROM_DEVICE FREEDOMFROM_MACBRIDGE
EOF
}

case "${1:-help}" in
  build)  shift; cmd_build ;;
  test)   shift; cmd_test ;;
  uitest) shift; cmd_uitest ;;
  run)    shift; cmd_run "$@" ;;
  shot)   shift; cmd_shot "$@" ;;
  log)    shift; cmd_log "$@" ;;
  rawlog) shift; cmd_rawlog "$@" ;;
  device) shift; cmd_device ;;
  clean)  shift; cmd_clean ;;
  help|-h|--help) cmd_help ;;
  *) echo "unknown verb: $1" >&2; echo >&2; cmd_help >&2; exit 2 ;;
esac
