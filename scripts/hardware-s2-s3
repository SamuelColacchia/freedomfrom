#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES
#
# Hardware gates S2 and S3 (docs/hardware-smoke-checklist.md, issue #23).
#
# These two are the tail of the walking skeleton, and they need a person: the
# picker's tokens exist only once a human has tapped them, S3's green condition
# is somebody looking at a row of checkmarks, and `log collect` is root-gated on
# the Mac. Everything either side of the taps is done here — the install, the
# log reads, the verdicts, the results table, and the amendment a red result
# fires — so what the human supplies is the phone and their eyes.
#
# Nothing in this script decides a result on the app's behalf. Each verdict is
# the human's observation and the log agreeing; where they disagree, the run is
# inconclusive and is re-run rather than recorded.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=8

# Overridable in the same names scripts/mac uses, so one export covers both.
HOST="${FREEDOMFROM_MAC_HOST:-mac}"
MAC_ROOT="${FREEDOMFROM_MAC_ROOT:-builds/freedomfrom}"
DEVICE="${FREEDOMFROM_DEVICE:-7EE3550E-8A48-5192-B729-961CB3FD51E9}"
SIGN_SOCKET="${FREEDOMFROM_SIGN_SOCKET:-$HOME/.ssh/cm/mac-sign}"

# The phone answers to two identifiers and they are not interchangeable.
# `devicectl --device` takes the CoreDevice UUID above; `log collect
# --device-udid` takes the ECID-derived hardware UDID, and handed the other one
# it fails with "Device not configured (6)" against a phone that is cabled,
# paired and unlocked. Resolved from the device in preflight rather than written
# down, so a second phone needs no edit here.
DEVICE_UDID="${FREEDOMFROM_DEVICE_UDID:-}"

SUBSYSTEM=com.samuelcolacchia.freedomfrom
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHECKLIST="$REPO/docs/hardware-smoke-checklist.md"
EVIDENCE="$REPO/docs/evidence"
ADR="$REPO/docs/adr"

# The archive is collected on the Mac, where the phone is cabled. Only the
# filtered text comes back: a .logarchive is a multi-hundred-megabyte bundle,
# and the lines matching our subsystem are what the checklist actually cites.
MAC_EVIDENCE="$MAC_ROOT/evidence"
ARCHIVE="\$HOME/$MAC_EVIDENCE/s2-s3.logarchive"

ENV_FILE="$EVIDENCE/answers.env"
AMENDED=()
RECORDED=()

mkdir -p "$EVIDENCE"

# ── Helpers particular to this wizard ─────────────────────────────────────

# remote_sh runs a script on the Mac, arriving on stdin so nothing is quoted
# twice. Same shape as scripts/mac, and password-free: every command here reads.
remote_sh() { ssh -o BatchMode=yes "$HOST" bash -s; }

# log_for CATEGORY prints this run's lines for one process. One category per
# process is what keeps "the extension never woke" distinguishable from "it
# woke and found nothing" (ADR 0009), and that distinction is the whole of S2.
log_for() {
  remote_sh <<EOF 2>/dev/null || true
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM" AND category == "$1"' \\
  --info --debug --style compact
EOF
}

# deadline_epoch HH:MM turns a wall-clock time into an epoch second, rolling to
# tomorrow only when today's would be more than twelve hours past — a run
# started at 23:50 for a 00:05 deadline is the case that needs it.
#
# The shape is checked before date(1) sees it, because date(1) is not a
# validator: `date -d "today 14m"` succeeds and silently means something else
# entirely, and `14m` is the literal answer the first run of this wizard was
# given where it asked for a clock time.
deadline_epoch() {
  local at now
  [[ "$1" =~ ^([01][0-9]|2[0-3]|[0-9]):[0-5][0-9](:[0-5][0-9])?$ ]] || return 1
  at=$(date -d "today $1" +%s 2>/dev/null) || return 1
  [[ -n "$at" ]] || return 1
  now=$(date +%s)
  (( at < now - 43200 )) && at=$(( at + 86400 ))
  printf '%s' "$at"
}

# wait_until EPOCH holds the human here until the deadline has actually passed.
#
# Opening the target early is the one mistake that makes S2 unanswerable, and it
# looks like nothing at the time: the shield still draws, just with a countdown
# on it. The first attempt at S2 was lost to exactly this, so the wait is the
# wizard's to hold rather than the human's to judge.
wait_until() {
  local at="$1" now left
  while :; do
    now=$(date +%s)
    (( now >= at )) && break
    left=$(( at - now ))
    # Redrawn in place, and onto a terminal only: _clear takes the same care so
    # that a piped log stays readable.
    if [[ -t 1 ]]; then
      printf '\r  %swaiting %02d:%02d for the deadline…%s\033[K' \
        "$DIM" $(( left / 60 )) $(( left % 60 )) "$RESET"
    fi
    sleep 1
  done
  [[ -t 1 ]] && printf '\r\033[K'
  printf '  %s✓%s the deadline has passed. Open the target now, without dawdling:\n' \
    "$GREEN" "$RESET"
  note "the Monitor wakes at the same boundary, and whoever gets there first wins."
}

# record_result CHECK RESULT EVIDENCE AMENDMENT rewrites one row of the results
# table in place, found by its check id. Column 2 — what the check decides — is
# never touched, and re-running overwrites rather than appending, so a repeated
# run of an inconclusive check leaves one row and not three.
#
# A pipe in a cell becomes `&#124;` rather than `\|`. Both render as a pipe, but
# a backslash-escaped one is still a pipe to awk, so a cell carrying one splits
# into two on the next run and pushes the amendment into a seventh column.
record_result() {
  local tmp
  tmp=$(mktemp)
  CHECK="$1" RESULT="${2//|/\&#124;}" CELL="${3//|/\&#124;}" AMEND="${4//|/\&#124;}" \
    awk '
      BEGIN { FS = "|"; OFS = "|" }
      function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      NF >= 7 && trim($2) == ENVIRON["CHECK"] {
        $4 = " " ENVIRON["RESULT"] " "
        $5 = " " ENVIRON["CELL"] " "
        $6 = " " ENVIRON["AMEND"] " "
        print; next
      }
      { print }
    ' "$CHECKLIST" > "$tmp"
  mv "$tmp" "$CHECKLIST"
  RECORDED+=("$1 → $2")
  printf '  %s✓ recorded%s %s in the results table\n' "$GREEN" "$RESET" "$1"
}

# amend_adr FILE HEADING <<< body appends a pre-written amendment, once.
#
# The wording is fixed here rather than composed at run time because the
# checklist binds an amendment to each check before it runs: a red result
# applies a decision that already exists, and reopening it is the one thing
# this whole procedure is built to prevent.
amend_adr() {
  local file="$ADR/$1" heading="$2" body
  body=$(cat)
  if [[ ! -f "$file" ]]; then
    warn "no such ADR: $1"
    SKIPPED+=("amend $1 by hand")
    return 0
  fi
  if grep -qF "$heading" "$file"; then
    note "already amended: $1"
    return 0
  fi
  printf '\n%s\n\n%s\n' "$heading" "$body" >> "$file"
  AMENDED+=("$1")
  printf '  %s✓ amended%s %s\n' "$GREEN" "$RESET" "$1"
}

# ──────────────────────────────────────────────────────────────────────────

banner "Hardware gates S2 and S3"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Preflight: the Mac, the cable, the keychain"
say "Three things have to be true before the phone is worth picking up."

if remote_sh <<<'true' 2>/dev/null; then
  printf '  %s✓%s the Mac build host (%s) answers\n' "$GREEN" "$RESET" "$HOST"
else
  warn "cannot reach $HOST over ssh. Nothing below will work; fix that first."
  exit 1
fi

if [[ -S "$SIGN_SOCKET" ]]; then
  printf '  %s✓%s a signing socket exists at %s\n' "$GREEN" "$RESET" "$SIGN_SOCKET"
else
  warn "no signing socket, so the build cannot be signed or installed."
  say "A person at their own shell runs these; the password never enters this session:"
  note "  mkdir -p $(dirname "$SIGN_SOCKET")"
  note "  ssh -o ControlMaster=yes -o ControlPath=$SIGN_SOCKET -o ControlPersist=8h -fN $HOST"
  note "  read -rs pw && printf '%s\\n' \"\$pw\" | ssh -o ControlPath=$SIGN_SOCKET $HOST \\"
  note "    'read -r p; security unlock-keychain -p \"\$p\" ~/Library/Keychains/login.keychain-db'"
  pause "Run those in another shell, then press Enter."
fi

if remote_sh <<EOF | grep -q "$DEVICE"
xcrun devicectl list devices 2>/dev/null
EOF
then
  printf '  %s✓%s the phone (%s) is connected\n' "$GREEN" "$RESET" "$DEVICE"
else
  warn "the phone is not visible to the Mac. Cable it, unlock it, and re-run."
  exit 1
fi

if [[ -z "$DEVICE_UDID" ]]; then
  DEVICE_UDID=$(
    remote_sh <<EOF 2>/dev/null || true
xcrun devicectl device info details --device $DEVICE \\
  --json-output /tmp/freedomfrom-device.json >/dev/null 2>&1 &&
  plutil -extract result.hardwareProperties.udid raw -o - /tmp/freedomfrom-device.json
EOF
  )
  DEVICE_UDID="${DEVICE_UDID//[[:space:]]/}"
fi

if [[ -n "$DEVICE_UDID" ]]; then
  printf '  %s✓%s its hardware UDID is %s\n' "$GREEN" "$RESET" "$DEVICE_UDID"
else
  warn "could not read the hardware UDID, which the log collect line needs."
  note "Read it yourself and export it, then re-run:"
  note "  xcrun devicectl device info details --device $DEVICE --json-output /tmp/d.json"
  note "  plutil -extract result.hardwareProperties.udid raw -o - /tmp/d.json"
  note "  export FREEDOMFROM_DEVICE_UDID=<the 00008120-… value>"
  exit 1
fi

pause "Ready?"

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Install the hardware-pass build"
say "S2 and S3 both need the release control, which no ordinary build contains."
note "It shortens a deadline so the pass can commit repeatedly without taking the"
note "Screen Time revoke, which is check X1 and would contaminate the clean run."
say ""
warn "This replaces whatever freedomfrom is on the phone."
note "The commitment record lives in the Keychain and survives that (ADR 0002),"
note "so anything currently running will still be running afterwards."

if confirm "Install FREEDOMFROM_HARDWARE_PASS=1 on $DEVICE now?"; then
  if FREEDOMFROM_HARDWARE_PASS=1 "$REPO/scripts/mac" device; then
    printf '  %s✓ installed%s\n' "$GREEN" "$RESET"
  else
    warn "install failed. Read the error above; scripts/mac rawlog has the rest."
    exit 1
  fi
else
  note "skipping the install — assuming a hardware-pass build is already on the phone"
  note "If it is not, the countdown will have no orange release row and S3 cannot be set up."
fi
pause

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "S2, part one: arm a commitment and walk away from it"
say "S2 asks whether ShieldConfig can mutate a ManagedSettingsStore inside its"
say "memory budget. To ask it, the deadline has to pass while nothing else is"
say "watching, so the extension is the process that discovers it."
say ""
if confirm "Is a commitment from an earlier run still armed and waiting?"; then
  say "Then this stage is already done; it only needs its deadline back."
  say ""
  warn "Read the deadline off the phone, but check the clocks agree first."
  note "This wizard runs here, not on the phone, and it turns the time you type"
  note "into an instant using THIS machine's clock and time zone. If the two"
  note "disagree, the wait at stage 4 targets the wrong moment and S2 is lost"
  note "again for a reason that will not show up in the log."
  note "  here, it is now $(date '+%H:%M:%S %Z')"
  say ""

  # A stored answer that is not a clock time must not come back as a default:
  # the first run of this wizard was answered `14m`, and it is still in the file.
  if stale=$(_existing S2_DEADLINE) && [[ -n "$stale" ]] &&
    ! deadline_epoch "$stale" >/dev/null 2>&1; then
    note "discarding the stored answer '$stale', which is not a clock time"
    write_env S2_DEADLINE ""
  fi

  S2_DEADLINE_AT=""
  while :; do
    ask S2_DEADLINE "What wall-clock time does it end? (24h, e.g. 14:35)"
    if S2_DEADLINE_AT=$(deadline_epoch "$S2_DEADLINE"); then
      write_env S2_DEADLINE "$S2_DEADLINE"
      note "reading that as $(date -d "@$S2_DEADLINE_AT" '+%F %H:%M:%S %Z')"
      break
    fi
    S2_DEADLINE_AT=""
    warn "'$S2_DEADLINE' is not a clock time. Answer like 14:35."
    confirm "Skip the check and judge the wait yourself?" && break
  done
else
  step "Open freedomfrom. If it offers 'Begin', take it and grant Screen Time access."
  step "On Targets, tap 'Choose apps' and check exactly ONE app — not freedomfrom."
  note "  Pick something you can open freely. The self-shield is a different check."
  step "Dismiss the picker. The count above should read 1."
  step "Tap 'Next', choose '15 minutes', and hold to commit."
  step "You should land on the countdown."
  say ""
  pause "Press Enter the moment the countdown appears."

  # Stamped rather than typed, because a typed time is a thing that can be
  # wrong: the first run of this wizard was answered `14m` and the wait at
  # stage 4 had nothing to hold. Stamped here rather than after the force-quit
  # below, because the app anchors its deadline when the hold completes, and
  # every second of drift past that is a second handed to the Monitor in the
  # race at stage 4.
  S2_DEADLINE_AT=$(( $(date +%s) + 15 * 60 ))
  S2_DEADLINE=$(date -d "@$S2_DEADLINE_AT" '+%H:%M:%S' 2>/dev/null || printf 'in 15 minutes')
  write_env S2_DEADLINE "$S2_DEADLINE"
  note "Deadline stamped at $S2_DEADLINE, a second or so after the app's own."
  say ""
  warn "Now force-quit freedomfrom: swipe up and flick the card away."
  note "The app reconciles on every launch and every foreground. If it is running"
  note "when the deadline passes, it releases the commitment and S2 sees nothing."
  say ""
  step "Do not open freedomfrom again until this wizard says so."
  pause "Force-quit?"
fi

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "S2, part two: open the shielded app at the deadline"
say "The wizard holds the wait, so leave the phone alone until it says otherwise."
say "Unlocked and idle, or locked — either is fine. Just do not open freedomfrom."
say ""
warn "There is a race here, and it decides whether the run counts."
note "The Monitor also wakes at the window boundary and also releases. If it gets"
note "there first the shield is already gone, which proves the Monitor works and"
note "proves nothing about S2. Opening the target promptly is what wins the race;"
note "the log below says which process actually got there, so a lost race is"
note "recorded as inconclusive and re-run rather than written down as a result."
say ""
if [[ -n "${S2_DEADLINE_AT:-}" ]]; then
  wait_until "$S2_DEADLINE_AT"
else
  pause "Press Enter once $S2_DEADLINE has passed."
fi
say ""
step "Now open the app you shielded."
step "Look at what you get, then press the Home gesture and open it a second time."

say ""
say "First open — what appeared?"
note "  a  a dark shield with a countdown on it"
note "  b  a dark shield reading just 'freedomfrom', no countdown"
note "  c  no shield: the app opened normally"
note "  d  the app flashed and threw me back to the Home Screen"
ask S2_FIRST "a / b / c / d:"
write_env S2_FIRST "$S2_FIRST"

if confirm "Second open: was the shield gone, and the app usable?"; then
  S2_CLEARED=yes
else
  S2_CLEARED=no
fi
write_env S2_CLEARED "$S2_CLEARED"

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Capture the log"
say "The record is a log archive collected from the device, read on the Mac."
say ""
warn "log collect is root-gated, so a person runs this line. It is not run here,"
warn "and the password does not enter this session."
say ""
note "  ssh $HOST"
note "  mkdir -p ~/$MAC_EVIDENCE"
note "  sudo log collect --device-udid $DEVICE_UDID --last 45m \\"
note "    --output ~/$MAC_EVIDENCE/s2-s3.logarchive"
note "  sudo chown -R \"\$(whoami)\" ~/$MAC_EVIDENCE/s2-s3.logarchive"
say ""
note "--last 45m has to cover the commit as well as the release."
pause "Collected?"

say "Reading it back, filtered to $SUBSYSTEM…"
if remote_sh <<EOF > "$EVIDENCE/s2-s3.log" 2>/dev/null
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM"' \\
  --info --debug --style compact
EOF
then
  lines=$(grep -c . "$EVIDENCE/s2-s3.log" || true)
  printf '  %s✓%s %s line(s) → docs/evidence/s2-s3.log\n' "$GREEN" "$RESET" "$lines"
  if [[ "$lines" -eq 0 ]]; then
    warn "The archive holds no lines from this subsystem."
    note "The contract logs at notice, which persists to the on-disk store, so the"
    note "level is unlikely to be what emptied this one. Check whether the phone is"
    note "running an older build that logged at info, or whether --last 45m reached"
    note "back far enough to cover the commit."
  fi
else
  warn "could not read the archive. Check the path and the chown line above."
  SKIPPED+=("re-read the archive into docs/evidence/s2-s3.log")
fi
pause

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "S2: the verdict"

shieldconfig=$(log_for shieldconfig)
monitor=$(log_for monitor)
printf '%s\n' "$shieldconfig" > "$EVIDENCE/s2-shieldconfig.log"
printf '%s\n' "$monitor" > "$EVIDENCE/s2-monitor.log"

sc_woke=no;     grep -q "woke reason=shielding" <<<"$shieldconfig" && sc_woke=yes
sc_released=no; grep -q "store mutation release landed=true" <<<"$shieldconfig" && sc_released=yes
mon_released=no; grep -q "store mutation release landed=true" <<<"$monitor" && mon_released=yes
mon_disarmed=no; grep -q "window suppressed" <<<"$(log_for app)$monitor" && mon_disarmed=yes

note "shieldconfig woke:               $sc_woke"
note "shieldconfig logged the release: $sc_released"
note "monitor logged the release:      $mon_released"
note "monitor's final window disarmed: $mon_disarmed"
note "what you saw on the first open:  $S2_FIRST"
say ""

if [[ "$mon_disarmed" == no ]]; then
  warn "The final window was armed, so this run was a race rather than a test."
  note "The hardware-pass build suppresses it precisely so ShieldConfig is the"
  note "only process that can release. No 'window suppressed' line means the phone"
  note "is running a build without that, and the Monitor will usually win."
  say ""
fi

# The screen is checked before the log, because on this one answer it is the
# stronger evidence. `ShieldConfig` draws a countdown only from a deadline that
# `Reconciliation.shouldRelease` says has not passed, so a countdown is proof
# the gate was never reached — whatever the archive did or did not hold. Read
# the other way round, an empty archive gets blamed for a run that was simply
# opened too early, which is what happened the first time S2 was walked.
if [[ "$S2_FIRST" == a ]]; then
  warn "INCONCLUSIVE — the deadline had not passed when you opened the target."
  say "The countdown on that shield is the tell: ShieldConfig draws one only"
  say "while the commitment is still running, and returns nothing once it has"
  say "released. So the mutation under test was never attempted."
  say ""
  say "Re-run, and answer yes when stage 3 asks if a commitment is still armed:"
  note "  the one you made is still live, and the wizard will hold the wait for you."
  record_result S2 "Inconclusive, re-run" \
    "The target was opened before the deadline — \`ShieldConfig\` drew a live countdown, which it does only while \`shouldRelease\` is false" \
    "None — not a result"
elif [[ "$mon_released" == yes && "$sc_released" == no ]]; then
  # Tested on the release, not on whether ShieldConfig woke. It wakes every time
  # a shielded target is opened, so "it never woke at all" is not what a lost
  # race looks like — and scoring on that let the first real run fall through to
  # RED and amend two ADRs for a race the human could not have won.
  warn "INCONCLUSIVE — the Monitor released first. The gate was never reached."
  say "ShieldConfig can only take a release nothing else has already taken."
  say "Whatever it logged, it did not discover this deadline."
  say ""
  if [[ "$mon_disarmed" == no ]]; then
    say "Install the hardware-pass build, which disarms the final window, and re-run."
  else
    say "The window was suppressed, so something else released. Read docs/evidence/s2-s3.log."
  fi
  record_result S2 "Inconclusive, re-run" \
    "\`monitor\` logged the release at the window boundary; \`ShieldConfig\` never reached its release path" \
    "None — not a result"
elif [[ "$S2_FIRST" == c && "$sc_released" == no ]]; then
  # Only when the log agrees. An app that opens normally is *usually* an app with
  # no shield on it — but it is also what a fast pass looks like from the seat of
  # the person tapping, because the release lands inside the call that was asked
  # to draw the shield. Scoring on the answer alone read the first green run as
  # inconclusive. The log decides; the answer only breaks a tie it cannot.
  warn "INCONCLUSIVE — no shield was drawn, and ShieldConfig logged no release."
  say "An app that opens normally with nothing in the archive is an app with no"
  say "shield on it. Enforcement was already gone, or was never applied, and"
  say "either way the gate was not reached."
  record_result S2 "Inconclusive, re-run" \
    "The target opened with no shield and \`shieldconfig\` logged no release, so it was never invoked for it" \
    "None — not a result"
elif [[ "$sc_woke" == no ]]; then
  warn "INCONCLUSIVE — ShieldConfig left no trace at all."
  say "The shield did not draw, or the capture window missed it. Re-run from stage 3."
  note "The logging contract is at notice level and persists to the on-disk store,"
  note "so the level is no longer the likeliest explanation for an empty archive."
  note "Check the build on the phone is current — an older one logs at info, which"
  note "may not survive the gap between the run and the collect."
  record_result S2 "Inconclusive, re-run" \
    "No \`shieldconfig\` lines in the archive" \
    "None — not a result"
elif [[ "$sc_released" == yes && "$S2_CLEARED" == yes ]]; then
  printf '  %s✓ GREEN%s — the extension mutated the store and the shield came down.\n' "$GREEN" "$RESET"
  if [[ "$S2_FIRST" == c ]]; then
    say "You saw no shield at all, which is this passing rather than this not"
    say "happening. iOS launches ShieldConfig only while the shield is still up,"
    say "so its running is the proof the target was blocked when you tapped it;"
    say "the release landed inside the same call, before anything was presented."
  fi
  # Split by source deliberately. Half of the green condition is a log line and
  # half is somebody looking at a screen, and a row that reads as though the
  # archive carried both is the fabricated row AGENTS.md rules out.
  detail="\`shieldconfig\` logs \`store mutation release landed=true\`, and logged again after it, so no jetsam. **The shield being gone on the next open is the human's answer, not a log line** — the archive corroborates it only by holding no further \`shieldconfig\` wake, which is absence of evidence"
  # The suppression is what makes the release attributable. With the final window
  # armed, the Monitor releases the same commitment and nothing here is a result.
  [[ "$mon_disarmed" == yes ]] &&
    detail="$detail. The final window was suppressed and \`monitor\` logged nothing, so the extension was the only process that could have taken it"
  record_result S2 "**Green**" "$detail" "None"
else
  printf '  %s✗ RED%s — ShieldConfig ran but the mutation did not land.\n' "$RED" "$RESET"
  say "The bound amendment fires. Both ADRs go together: they rest on the same premise."
  detail="\`shieldconfig\` woke but logged no landed release"
  [[ "$S2_FIRST" == d ]] && detail="$detail; the extension was killed on launch (jetsam)"
  [[ "$S2_CLEARED" == no ]] && detail="$detail; the shield was still up on the next open"
  record_result S2 "**Red**" "$detail" \
    "**Fired.** [ADR 0004](./adr/0004-commitments-run-to-a-year-on-a-walked-forward-watchdog.md) and [ADR 0005](./adr/0005-what-v1-repairs-and-what-it-accepts.md) amended together"

  amend_adr "0004-commitments-run-to-a-year-on-a-walked-forward-watchdog.md" \
    "## Amended by hardware: two reconciliation points, not three" <<'ADR0004'
> Hardware smoke check S2, run on the walking skeleton, came back **red**.
> `ShieldConfig` cannot mutate a `ManagedSettingsStore` from inside its memory
> budget. The rest of this ADR is unchanged: the walk-forward step, the absolute
> deadline, and the late-never-early direction all stand.

The table of three reconciliation points loses its third row. `Monitor` and the
app remain; the extension that draws the shield now only draws it.

This costs the design the point that fired at the moment of harm, which was the
one that caught a stale shield the instant someone reached for a target. What
replaces it is the deferred local notification this ADR held in reserve: at the
deadline, a notification pulls the user back into the app, and the app
reconciles. That was rejected for costing a permission prompt in front of
"Begin" and for giving a wordless app its first words. Both costs are now paid,
because the alternative is a shield that outlives its commitment until something
else happens to run.

**A commitment can still only end late, never early.** The shield holds itself,
and losing a reconciliation point widens the window in the accepted direction.
ADR0004

  amend_adr "0005-what-v1-repairs-and-what-it-accepts.md" \
    "## Amended by hardware: the self-shield is accepted, not repaired" <<'ADR0005'
> Hardware smoke check S2 came back **red**, and it took the self-shield fix with
> it. Both rested on the same unverified premise — that `ShieldConfig` can mutate
> a `ManagedSettingsStore` — which this ADR named in its own consequences.

The repaired table loses its row for "the user picks freedomfrom itself as a
target". It moves to accepted, with this reason: the only process that can
recognise the app's own token is the only process that cannot act on it.

**Someone who shields freedomfrom keeps it shielded, for the length of the
commitment.** That is a real cost and it is worth stating plainly rather than
softening: a mis-tap in the picker can put the countdown, the history, and the
ability to commit again behind a shield for up to a year. Nothing in the app
lifts it, because ADR 0001 builds no lever that could. The route out is the one
the app already names on the countdown: revoke authorization in Settings, which
is escape route 1 and marks the commitment broken.

Shielding freedomfrom still buys the user no enforcement, so this is a footgun
with no upside — it is simply one the app cannot take away.
ADR0005
fi
pause

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "S3: already answered, and no longer testable here"
say "S3 asked whether a FamilyActivitySelection decoded from the Keychain hands"
say "back to FamilyActivityPicker with its apps still checked. It came back red,"
say "and its bound amendment has been applied: ADR 0008's draft keeps the typed"
say "web domains and the length, and apps are re-picked every time."
say ""
warn "So this stage cannot be walked any more, and is skipped rather than scored."
note "The code caught up with that amendment in #38: the app no longer stores a"
note "selection or restores one into the picker. Asking a build built not to"
note "remember whether it remembers can only produce 'the picker arrived empty',"
note "which is #38 working rather than anything about the platform."
say ""
note "A run that scored it anyway would overwrite a real result — some tokens came"
note "back checked and some did not — with a tautology. The row stands as it is."
pause
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "What this run produced"
say "Results table rows written into docs/hardware-smoke-checklist.md:"
for r in "${RECORDED[@]}"; do note "  $r"; done
say ""
if (( ${#AMENDED[@]} )); then
  say "ADRs amended in place:"
  for a in "${AMENDED[@]}"; do note "  $a"; done
else
  note "No amendment fired."
fi
say ""
say "Evidence saved beside the checklist:"
note "  docs/evidence/s2-s3.log            every line from this subsystem"
note "  docs/evidence/s2-shieldconfig.log  the extension under test"
note "  docs/evidence/s2-monitor.log       the process it was racing"
note "  docs/evidence/answers.env          what you reported seeing"
note "The .logarchive itself stays on $HOST at ~/$MAC_EVIDENCE, being far too large to commit."
say ""
say "Review the diff before committing it. Nothing here is worth more than its evidence."

finish
