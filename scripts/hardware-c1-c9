#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES
#
# The clean hardware run, C1 through C9 (docs/hardware-smoke-checklist.md,
# issue #31).
#
# One 15-minute commitment, one app target and one typed web domain, observed
# end to end. Nothing in this phase breaks anything, and that is the point: a
# break contaminates every later observation of a clean run, which is why the
# revoke and the delete live in their own commitment.
#
# What the human supplies is the phone and their eyes. Everything either side of
# the taps is done here — the install, the wait, the capture, the verdicts, the
# results table, and the amendment a red result fires.
#
# Two things this script will not do.
#
# It will not score a run that was not clean. A hardware-pass build announces
# itself on every launch, and if that line is in the archive no row is written.
#
# It will not fill in a row it did not observe. Every verdict is the human's
# answer and the log agreeing; where they disagree the check is inconclusive and
# re-run, and where a check cannot be reached at all the row says so and says
# why. A fabricated row is worse than an empty one, because every claim the app
# makes is reconciled against this table before TestFlight.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=15

# Overridable in the same names scripts/mac uses, so one export covers both.
HOST="${FREEDOMFROM_MAC_HOST:-mac}"
MAC_ROOT="${FREEDOMFROM_MAC_ROOT:-builds/freedomfrom}"
DEVICE="${FREEDOMFROM_DEVICE:-7EE3550E-8A48-5192-B729-961CB3FD51E9}"
SIGN_SOCKET="${FREEDOMFROM_SIGN_SOCKET:-$HOME/.ssh/cm/mac-sign}"

# `devicectl --device` takes the CoreDevice UUID above; `log collect
# --device-udid` takes the ECID-derived hardware UDID. Resolved in preflight
# rather than written down, so a second phone needs no edit here.
DEVICE_UDID="${FREEDOMFROM_DEVICE_UDID:-}"

SUBSYSTEM=com.samuelcolacchia.freedomfrom
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHECKLIST="$REPO/docs/hardware-smoke-checklist.md"
EVIDENCE="$REPO/docs/evidence"
ADR="$REPO/docs/adr"

MAC_EVIDENCE="$MAC_ROOT/evidence"
ARCHIVE="\$HOME/$MAC_EVIDENCE/c1-c9.logarchive"

# A domain nobody typed, loaded beside the blocked one. It is what separates
# "the filter refused it" from "this phone has no network", and C3a is a gate
# now, so that distinction decides whether half the product survives.
CONTROL_DOMAIN="${FREEDOMFROM_CONTROL_DOMAIN:-wikipedia.org}"

ENV_FILE="$EVIDENCE/answers-c1-c9.env"
AMENDED=()
RECORDED=()
FOLLOWUP=()
EXPIRED=()

mkdir -p "$EVIDENCE"

# A wizard with no one answering it is not a cheap no-op. `observe` gives up on
# EOF and leaves the answer empty, `confirm` reads a blank as no, and `pause`
# returns at once — so a non-interactive run races to the end and overwrites
# $ENV_FILE with a column of empty answers. That file is the only record of what
# a human saw, and a real half-walked run has been destroyed by exactly this.
#
# So: a terminal, or nothing.
if [[ ! -t 0 ]]; then
  cat >&2 <<EOF
$(basename "${BASH_SOURCE[0]}") needs a terminal: it is a wizard, and every row
it writes is a person's answer.

With nothing on stdin it would run to the end answering itself, and overwrite
$ENV_FILE with blanks.
EOF
  exit 2
fi

# ── Helpers particular to this wizard ─────────────────────────────────────

# remote_sh runs a script on the Mac, arriving on stdin so nothing is quoted
# twice. Password-free: every command here reads.
remote_sh() { ssh -o BatchMode=yes "$HOST" bash -s; }

# log_for CATEGORY prints this run's lines for one process. One category per
# process is what keeps "the extension never woke" distinguishable from "it woke
# and found nothing" (ADR 0009).
log_for() {
  remote_sh <<EOF 2>/dev/null || true
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM" AND category == "$1"' \\
  --info --debug --style compact
EOF
}

# deadline_epoch HH:MM turns a wall-clock time into an epoch second, rolling to
# tomorrow only when today's would be more than twelve hours past.
#
# The shape is checked before date(1) sees it, because date(1) is not a
# validator: `date -d "today 14m"` succeeds and silently means something else.
deadline_epoch() {
  local at now
  [[ "$1" =~ ^([01][0-9]|2[0-3]|[0-9]):[0-5][0-9](:[0-5][0-9])?$ ]] || return 1
  at=$(date -d "today $1" +%s 2>/dev/null) || return 1
  [[ -n "$at" ]] || return 1
  now=$(date +%s)
  (( at < now - 43200 )) && at=$(( at + 86400 ))
  printf '%s' "$at"
}

# still_running succeeds while the commitment's deadline is in the future.
#
# Fifteen minutes is a real budget and the checks in the middle of this run are
# a person switching between four browsers and the Settings app. A check reached
# after the release is a check asked about an unenforced phone, and answering it
# honestly still produces a wrong row — so the wizard tracks the clock rather
# than trusting anyone to notice.
still_running() {
  [[ -n "${DEADLINE_AT:-}" ]] || return 0
  (( $(date +%s) < DEADLINE_AT ))
}

# budget prints what is left, so the human can pace the middle of the run.
budget() {
  local left
  [[ -n "${DEADLINE_AT:-}" ]] || return 0
  left=$(( DEADLINE_AT - $(date +%s) ))
  if (( left > 0 )); then
    note "$(printf '%d:%02d' $(( left / 60 )) $(( left % 60 ))) left on the commitment"
  else
    warn "the commitment has already ended. Anything below is asked of an unenforced phone."
  fi
}

# check_open CHECK succeeds while there is still a commitment to observe. When
# there is not, the check is not asked at all: a question about an unenforced
# phone has an answer, and writing that answer down is how a run produces a row
# that is honest question by question and wrong as a result.
check_open() {
  still_running && return 0
  warn "$1 was reached after the deadline, so nothing is being enforced."
  note "It is not asked. An answer gathered now would describe a phone with no"
  note "commitment on it, which is not what this row is about."
  EXPIRED+=("$1")
  return 1
}

was_expired() {
  local c
  for c in ${EXPIRED[@]+"${EXPIRED[@]}"}; do [[ "$c" == "$1" ]] && return 0; done
  return 1
}

# expired_note CHECK records a check the run ran out of time for, rather than
# scoring it against a phone that is no longer being enforced.
expired_note() {
  record_result "$1" "Inconclusive, re-run" \
    "The commitment released before this check was reached, so the phone under it was no longer enforced and it was not asked" \
    "None — not a result"
}

# observe KEY "Prompt" reads an observation and stores it.
#
# Unlike ask, it never offers the previous run's answer as a default. A stored
# answer to "was it refused?" is the shortest path there is to a row nobody
# looked at, and keeping those out of the table is what this whole procedure is.
#
# It also re-asks a blank, until there is nobody left to ask. Every verdict
# below reads its answer against `^[Yy]`, so an empty string is not a missing
# answer to those tests — it is a "no", and at C6 a "no" fires an ADR 0003
# amendment that rewrites the app's only sentence about informed consent. One
# stray Enter should not be able to do that.
#
# On EOF it gives up and leaves the answer empty rather than spinning, so the
# blank can still reach a verdict. That is why the two checks with a bound
# amendment — C3a and C6 — test for an empty answer themselves and record
# inconclusive, rather than trusting this to have caught it.
observe() {
  local key="$1" prompt="$2" input
  while :; do
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
    if ! read -r input; then
      # EOF: there is no one left to ask. Leave it empty rather than spin, and
      # let the verdict stage record whatever it records for an unobserved
      # check — which, for the two that can fire an amendment, is inconclusive.
      warn "no more input, so this is left unanswered."
      input=""
      break
    fi
    [[ -n "$input" ]] && break
    warn "That needs an answer. A blank reads as 'no' to every test below, and a"
    warn "row written from one is a row nobody looked at."
  done
  printf -v "$key" '%s' "$input"
  write_env "$key" "$input"
}

# wait_until EPOCH holds the human here until the deadline has actually passed.
wait_until() {
  local at="$1" now left
  while :; do
    now=$(date +%s)
    (( now >= at )) && break
    left=$(( at - now ))
    if [[ -t 1 ]]; then
      printf '\r  %swaiting %02d:%02d for the deadline…%s\033[K' \
        "$DIM" $(( left / 60 )) $(( left % 60 )) "$RESET"
    fi
    sleep 1
  done
  [[ -t 1 ]] && printf '\r\033[K'
  printf '  %s✓%s the deadline has passed.\n' "$GREEN" "$RESET"
}

# record_result CHECK RESULT EVIDENCE AMENDMENT rewrites one row of the results
# table in place, found by its check id. Column 2 — what the check decides — is
# never touched, and re-running overwrites rather than appending.
#
# A pipe in a cell becomes `&#124;` rather than `\|`. Both render as a pipe, but
# a backslash-escaped one is still a pipe to awk, so a cell containing one would
# split into two on the next run and quietly push the amendment into a seventh
# column. The entity is invisible to the field splitter, which is the only
# reader that matters here.
record_result() {
  local tmp
  tmp=$(mktemp)
  CHECK="$1" RESULT="${2//|/\&#124;}" CELL="${3//|/\&#124;}" AMEND="${4//|/\&#124;}" \
    awk '
      BEGIN { FS = "|"; OFS = "|" }
      function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      NF >= 7 && trim($2) == ENVIRON["CHECK"] {
        $4 = " " ENVIRON["RESULT"] " "
        $5 = " " ENVIRON["CELL"] " "
        $6 = " " ENVIRON["AMEND"] " "
        print; next
      }
      { print }
    ' "$CHECKLIST" > "$tmp"
  mv "$tmp" "$CHECKLIST"
  RECORDED+=("$1 → $2")
  printf '  %s✓ recorded%s %s in the results table\n' "$GREEN" "$RESET" "$1"
}

# amend_adr FILE HEADING <<< body appends a pre-written amendment, once.
#
# The wording is fixed here rather than composed at run time because the
# checklist binds an amendment to each check before it runs: a red result applies
# a decision that already exists, and reopening it is the one thing this whole
# procedure is built to prevent. Where a check can fail in more than one way,
# each way has its own pre-written body and the run selects between them.
amend_adr() {
  local file="$ADR/$1" heading="$2" body
  body=$(cat)
  if [[ ! -f "$file" ]]; then
    warn "no such ADR: $1"
    SKIPPED+=("amend $1 by hand")
    return 0
  fi
  if grep -qF "$heading" "$file"; then
    note "already amended: $1"
    return 0
  fi
  printf '\n%s\n\n%s\n' "$heading" "$body" >> "$file"
  AMENDED+=("$1")
  printf '  %s✓ amended%s %s\n' "$GREEN" "$RESET" "$1"
}

# ──────────────────────────────────────────────────────────────────────────

banner "The clean hardware run · C1 through C9"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Preflight: the Mac, the cable, the keychain"
# The library banner offers to remember values across runs, and for the setup
# answers it does. Observations are deliberately exempt: `observe` never offers
# a previous answer as a default, because a stored answer to "was it refused?"
# is the shortest route there is to a row nobody looked at.
note "One correction to that banner: what you observe is never remembered."
note "Setup answers come back on a re-run; answers about what the phone did are"
note "asked again every time, because a default is how an unlooked-at row gets in."
say ""
say "Three things have to be true before the phone is worth picking up."

if remote_sh <<<'true' 2>/dev/null; then
  printf '  %s✓%s the Mac build host (%s) answers\n' "$GREEN" "$RESET" "$HOST"
else
  warn "cannot reach $HOST over ssh. Nothing below will work; fix that first."
  exit 1
fi

if [[ -S "$SIGN_SOCKET" ]]; then
  printf '  %s✓%s a signing socket exists at %s\n' "$GREEN" "$RESET" "$SIGN_SOCKET"
else
  warn "no signing socket, so the build cannot be signed or installed."
  say "A person at their own shell runs these; the password never enters this session:"
  note "  mkdir -p $(dirname "$SIGN_SOCKET")"
  note "  ssh -o ControlMaster=yes -o ControlPath=$SIGN_SOCKET -o ControlPersist=8h -fN $HOST"
  note "  read -rs pw && printf '%s\\n' \"\$pw\" | ssh -o ControlPath=$SIGN_SOCKET $HOST \\"
  note "    'read -r p; security unlock-keychain -p \"\$p\" ~/Library/Keychains/login.keychain-db'"
  pause "Run those in another shell, then press Enter."
fi

if remote_sh <<EOF | grep -q "$DEVICE"
xcrun devicectl list devices 2>/dev/null
EOF
then
  printf '  %s✓%s the phone (%s) is connected\n' "$GREEN" "$RESET" "$DEVICE"
else
  warn "the phone is not visible to the Mac. Cable it, unlock it, and re-run."
  exit 1
fi

if [[ -z "$DEVICE_UDID" ]]; then
  DEVICE_UDID=$(
    remote_sh <<EOF 2>/dev/null || true
xcrun devicectl device info details --device $DEVICE \\
  --json-output /tmp/freedomfrom-device.json >/dev/null 2>&1 &&
  plutil -extract result.hardwareProperties.udid raw -o - /tmp/freedomfrom-device.json
EOF
  )
  DEVICE_UDID="${DEVICE_UDID//[[:space:]]/}"
fi

if [[ -n "$DEVICE_UDID" ]]; then
  printf '  %s✓%s its hardware UDID is %s\n' "$GREEN" "$RESET" "$DEVICE_UDID"
else
  warn "could not read the hardware UDID, which the log collect line needs."
  note "Read it yourself and export it, then re-run:"
  note "  export FREEDOMFROM_DEVICE_UDID=<the 00008120-… value>"
  exit 1
fi

say ""
say "You will also need, before the commitment is armed:"
step "a website you can reach, and are willing to lose for fifteen minutes"
step "one app to block that is not freedomfrom, and that you can open freely"
step "Chrome, Firefox and Brave installed, if the survey at C3b is to mean anything"
step "any app with an in-app browser — a link in a mail or a chat opens one"
note "The control domain is $CONTROL_DOMAIN. Do not type that one into the app."
pause "Ready?"

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Install a clean build"
say "The clean run has to be walked on the build that ships, not on the one the"
say "walking skeleton used."
say ""
warn "No FREEDOMFROM_HARDWARE_PASS here."
note "That build carries a release control, and it announces itself on every"
note "launch — 'woke reason=hardware-pass build'. The capture at C9 is checked"
note "for that line, and if it is there no row is written, because a build with"
note "a way out of a commitment is not the product the checklist is about."
say ""
warn "This replaces whatever freedomfrom is on the phone."
note "The commitment record lives in the Keychain and survives that (ADR 0002),"
note "so anything currently running will still be running afterwards."

if confirm "Install a clean build on $DEVICE now?"; then
  if FREEDOMFROM_DEVICE="$DEVICE" "$REPO/scripts/mac" device; then
    printf '  %s✓ installed%s\n' "$GREEN" "$RESET"
  else
    warn "install failed. Read the error above; scripts/mac rawlog has the rest."
    exit 1
  fi
else
  note "skipping the install — assuming a clean build is already on the phone."
  note "The countdown must have no orange 'release · hardware-pass build' row on it."
fi
pause

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "C1 · First run states what it costs"
say "C1 asks whether the consent sentence is visible before the hold, and whether"
say "the authorization prompt appears. It is the whole of informed consent."
say ""
step "Open freedomfrom and look at the first screen it settles on."
say ""
say "Which is it?"
note "  a  'Begin', under two lines about blocking what you choose"
note "  b  Targets: a picker, a place to type a domain"
note "  c  a countdown — something is still running from an earlier session"
observe C1_SCREEN "a / b / c:"

if [[ "$C1_SCREEN" == a ]]; then
  say ""
  say "Read the screen before you touch it."
  observe C1_SENTENCE "Does it say no app on this phone can be deleted while it runs? (y/n)"
  step "Now tap 'Begin'."
  observe C1_PROMPT "Did iOS ask for Screen Time access? (y/n)"
  note "Grant it. Refusing is check X2's business, in the other run."
else
  warn "First run has already been consumed on this phone, so C1 cannot be walked."
  say "It shows once ever. The Keychain record outlives app deletion (ADR 0002),"
  say "and clean slate deliberately does not reset it (ADR 0008), so there is no"
  say "route back to that screen from here."
  say ""
  note "That is a finding rather than a failure, and the row will say so: the"
  note "sentence carrying all of this product's informed consent cannot be"
  note "re-observed on any phone that has already run the app."
  C1_SENTENCE=""; C1_PROMPT=""
fi
pause

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Arm the commitment"
say "One app, one typed domain, fifteen minutes. Everything from here to C8 is"
say "observed against this one commitment."
say ""

if confirm "Is a commitment from an earlier run still armed and waiting?"; then
  warn "Read its deadline off the phone, but check the clocks agree first."
  note "This wizard runs here, not on the phone, and turns the time you type into"
  note "an instant using THIS machine's clock and time zone."
  note "  here, it is now $(date '+%H:%M:%S %Z')"
  say ""
  DEADLINE_AT=""
  while :; do
    ask C_DEADLINE "What wall-clock time does it end? (24h, e.g. 14:35)"
    if DEADLINE_AT=$(deadline_epoch "$C_DEADLINE"); then
      write_env C_DEADLINE "$C_DEADLINE"
      note "reading that as $(date -d "@$DEADLINE_AT" '+%F %H:%M:%S %Z')"
      break
    fi
    DEADLINE_AT=""
    warn "'$C_DEADLINE' is not a clock time. Answer like 14:35."
    confirm "Skip the check and judge the wait yourself?" && break
  done
  observe C_DOMAIN "Which domain did you type into it?"
else
  step "On Targets, tap 'Choose apps' and check exactly ONE app — not freedomfrom."
  note "  Pick something you can open freely. The self-shield is a different check."
  step "Dismiss the picker. The count above should read 1."
  step "Type one web domain into the field and press return."
  note "  A bare host: example.com, no https://, no trailing slash."
  say ""
  observe C_DOMAIN "Which domain did you type?"
  while [[ "$C_DOMAIN" == "$CONTROL_DOMAIN" || -z "$C_DOMAIN" ]]; do
    warn "C3a needs a typed domain and a control that are not the same host."
    observe C_DOMAIN "Type a different one into the app, and name it here:"
  done
  say ""
  step "Tap 'Next', choose '15 minutes', and hold to commit."
  step "You should land on the countdown."
  pause "Press Enter the moment the countdown appears."

  # Stamped rather than typed. A typed time is a thing that can be wrong, and
  # the first run of the S2 wizard was answered `14m` for a wall-clock question.
  DEADLINE_AT=$(( $(date +%s) + 15 * 60 ))
  C_DEADLINE=$(date -d "@$DEADLINE_AT" '+%H:%M:%S' 2>/dev/null || printf 'in 15 minutes')
  write_env C_DEADLINE "$C_DEADLINE"
  note "Deadline stamped at $C_DEADLINE, a second or so after the app's own."
fi

say ""
warn "There is a clock on the rest of this run now."
note "C2 through C7 are asked of an enforced phone. Once the deadline passes,"
note "nothing is enforced and the answers stop meaning anything, so anything"
note "reached late is recorded as inconclusive rather than scored."
budget
pause

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "C2 · The shield applies"
budget
if check_open C2; then
  say ""
  step "Open the app you blocked."
  say ""
  say "What appeared?"
  note "  a  a dark shield instead of the app"
  note "  b  nothing: the app opened normally"
  note "  c  it flashed and threw me back to the Home Screen"
  observe C2_SHIELD "a / b / c:"
fi
pause

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "C3a · Does the filter block anything at all?"
budget
if check_open C3a; then
  say ""
  say "This is a gate. Red here takes web targets out of v1 (ADR 0006), so it is"
  say "asked against a control: a domain nobody typed, which must still load."
  say ""
  step "In Safari, load $C_DOMAIN"
  observe C3A_BLOCKED "Was it refused? (y/n)"
  say ""
  step "Now, in the same browser, load $CONTROL_DOMAIN"
  observe C3A_CONTROL "Did that one load normally? (y/n)"

  if [[ "$C3A_CONTROL" =~ ^[Nn] ]]; then
    warn "The control did not load either, so this phone has no working network."
    note "Nothing about the filter can be read out of that. Fix the connection and"
    note "re-run: a page that fails to load is not a page that was blocked."
  fi
fi
pause

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "C3b · Which other browsers does it cover?"
budget
say ""
C3B_CHROME=""; C3B_FIREFOX=""; C3B_BRAVE=""; C3B_WEBVIEW=""
if [[ ! "${C3A_BLOCKED:-}" =~ ^[Yy] ]]; then
  say "Skipped: C3a did not come back green, so there is no coverage to survey."
elif check_open C3b; then
  say "A survey, not a pass or a fail. Write down exactly what each one did; the"
  say "targets step will name only these and will never generalize."
  say ""
  note "Answer y if the browser refused $C_DOMAIN, n if it loaded it,"
  note "and - if that browser is not installed."
  say ""
  observe C3B_CHROME "Chrome:  (y/n/-)"
  observe C3B_FIREFOX "Firefox: (y/n/-)"
  observe C3B_BRAVE "Brave:   (y/n/-)"
  say ""
  note "For the last one, open a link in an app that shows it without leaving —"
  note "a link in Mail or a chat. That is a WKWebView, and it is the case nobody"
  note "thinks about until a blocked site opens inside another app."
  observe C3B_WEBVIEW "In-app WKWebView: (y/n/-)"
fi
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "C4 · Does a bare domain cover its subdomains?"
budget
say ""
C4_WWW=""; C4_M=""
if [[ ! "${C3A_BLOCKED:-}" =~ ^[Yy] ]]; then
  say "Skipped: nothing was blocked at C3a, so there is no matching rule to probe."
elif check_open C4; then
  say "Amendment either way. If subdomains are not covered, canonicalization"
  say "stands unchanged and the user types each host; if they are, that becomes a"
  say "claim the targets step may make."
  say ""
  step "In Safari, load www.$C_DOMAIN"
  observe C4_WWW "Refused? (y/n)"
  step "Then load m.$C_DOMAIN"
  note "  If that host does not exist, answer - rather than guessing."
  observe C4_M "Refused? (y/n/-)"
fi
pause

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "C5 · Private Browsing is off while the filter holds"
budget
say ""
say "Apple documents this. It is confirmed here because the targets screen says"
say "it, and no claim in this app goes unchecked."
say ""
say "It is also how C3a's red is read. Private Browsing switching off is caused"
say "by the policy applying, not by it blocking — so this answer separates a"
say "filter that landed and does nothing from one that never landed at all."
say ""
if check_open C5; then
  step "Open Safari and bring up the tab switcher."
  observe C5_PRIVATE "Is Private Browsing unavailable? (y/n)"
fi
pause

# ── 10 ────────────────────────────────────────────────────────────────────
stage "C6 · Do the restrictions bite under .individual?"
budget
say ""
warn "This is the check that matters most before a stranger installs the app."
note "Informed consent rests entirely on one first-run sentence, and that"
note "sentence makes both of the claims below. If either silently no-ops, the"
note "app is claiming a restriction that does not exist."
say ""
if check_open C6; then
  step "On the Home Screen, try to delete the OTHER app — not freedomfrom."
  note "  Long-press, Remove App, Delete App. Go as far as it lets you."
  observe C6_DELETE "Was it refused? (y/n)"
  say ""
  step "Now Settings → General → Date & Time, and try to switch off 'Set Automatically'."
  observe C6_CLOCK "Was it refused? (y/n)"
  say ""
  note "Nothing in the log corroborates either answer. There is no read-back of"
  note "effective state anywhere in ManagedSettings (ADR 0005), so the app cannot"
  note "tell whether a restriction it wrote is governing the device. Your eyes are"
  note "the only instrument this check has, and the row will say that."
fi
pause

# ── 11 ────────────────────────────────────────────────────────────────────
stage "C7 · Coverage reads true"
budget
say ""
say "The countdown states what is actually enforced, not what was named at"
say "commit. It is the substitute for every message the app refuses to show."
say ""
if check_open C7; then
  step "Open freedomfrom and read the small line under the timer."
  say ""
  observe C7_READS "What does it say, exactly? (e.g. '2 of 2 covered')"
  note "Not judged here. The log states the app half and you typed one domain, so"
  note "what that line should read is arithmetic the verdict stage does."
fi
pause

# ── 12 ────────────────────────────────────────────────────────────────────
stage "C8 · The release arrives"
say "Wait out the deadline. Do not open the app."
say ""
warn "Leave freedomfrom closed until this wizard says otherwise."
note "The app reconciles on every launch and every foreground. If it is open when"
note "the deadline passes, the app takes the release and the question of whether"
note "one arrives on its own goes unasked."
say ""
if [[ -n "${DEADLINE_AT:-}" ]]; then
  wait_until "$DEADLINE_AT"
else
  pause "Press Enter once ${C_DEADLINE:-the deadline} has passed."
fi
say ""
note "Late is the accepted direction and early is not, so give it a moment before"
note "calling it. The window boundary is when the Monitor wakes, not when iOS"
note "promises to run it."
say ""
step "Open the app you blocked."
observe C8_LIFTED "Did it open normally, with no shield? (y/n)"
step "Load $C_DOMAIN in Safari."
observe C8_DOMAIN_FREE "Did it load? (y/n)"
say ""
step "Now open freedomfrom, and go to the history line."
say "What does the row for this commitment read?"
note "  a  completed"
note "  b  broken"
note "  c  there is no row"
observe C8_HISTORY "a / b / c:"
pause

# ── 13 ────────────────────────────────────────────────────────────────────
stage "C9 · Capture"
say "One capture for the whole run, not one per check."
say ""
warn "log collect is root-gated, so a person runs this line. It is not run here,"
warn "and the password does not enter this session."
say ""
note "  ssh $HOST"
note "  mkdir -p ~/$MAC_EVIDENCE"
note "  sudo log collect --device-udid $DEVICE_UDID --last 60m \\"
note "    --output ~/$MAC_EVIDENCE/c1-c9.logarchive"
note "  sudo chown -R \"\$(whoami)\" ~/$MAC_EVIDENCE/c1-c9.logarchive"
say ""
note "--last 60m has to reach back past the commit, not just the release."
pause "Collected?"

say "Reading it back, filtered to $SUBSYSTEM…"
if remote_sh <<EOF > "$EVIDENCE/c1-c9.log" 2>/dev/null
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM"' \\
  --info --debug --style compact
EOF
then
  lines=$(grep -c . "$EVIDENCE/c1-c9.log" || true)
  printf '  %s✓%s %s line(s) → docs/evidence/c1-c9.log\n' "$GREEN" "$RESET" "$lines"
  if [[ "$lines" -eq 0 ]]; then
    warn "The archive holds no lines from this subsystem."
    note "The contract logs at notice, which persists to the on-disk store, so the"
    note "level is unlikely to be the cause. Check the phone is running a current"
    note "build, and that --last 60m reached back far enough to cover the commit."
  fi
else
  warn "could not read the archive. Check the path and the chown line above."
  SKIPPED+=("re-read the archive into docs/evidence/c1-c9.log")
fi
pause

# ── 14 ────────────────────────────────────────────────────────────────────
stage "The verdicts"

app=$(log_for app)
monitor=$(log_for monitor)
shieldconfig=$(log_for shieldconfig)
printf '%s\n' "$app" > "$EVIDENCE/c1-c9-app.log"
printf '%s\n' "$monitor" > "$EVIDENCE/c1-c9-monitor.log"
printf '%s\n' "$shieldconfig" > "$EVIDENCE/c1-c9-shieldconfig.log"
everything="$app$monitor$shieldconfig"

# Before anything is scored. A build with a way out of a commitment is not the
# product, and a clean run walked on one is not a clean run.
if grep -q "woke reason=hardware-pass build" <<<"$app"; then
  warn "STOP — the archive says this was a hardware-pass build."
  say "That build compiles in a release control, which the product does not have."
  say "Nothing observed under it is a fact about what ships, so no row is written."
  say ""
  say "Install a clean build — scripts/mac device, with no FREEDOMFROM_HARDWARE_PASS"
  say "in the environment — and walk the run again."
  finish
  exit 1
fi

enforcement=no; grep -q "store mutation enforcement landed=true" <<<"$everything" && enforcement=yes
sc_woke=no;     grep -q "woke reason=shielding" <<<"$shieldconfig" && sc_woke=yes
released=no;    grep -q "released late_by_seconds=" <<<"$everything" && released=yes
late_by=$(grep -o "late_by_seconds=[0-9]*" <<<"$everything" | tail -n1 | cut -d= -f2)
auth=$(grep -o "authorization state=[A-Za-z]*" <<<"$app" | tail -n1 | cut -d= -f2)
cov=$(grep -o "coverage resolved=[0-9]* of named=[0-9]*" <<<"$everything" | tail -n1)
cov_resolved=$(grep -o "resolved=[0-9]*" <<<"$cov" | cut -d= -f2)
cov_named=$(grep -o "named=[0-9]*" <<<"$cov" | cut -d= -f2)

note "enforcement applied:        $enforcement"
note "shieldconfig woke:          $sc_woke"
note "release logged:             $released${late_by:+, late by ${late_by}s}"
note "last authorization state:   ${auth:-none}"
note "last coverage line:         ${cov:-none}"
say ""
pause

# >>> verdicts begin — everything to the matching marker is pure: it reads the
# answers and the parsed log facts, and calls record_result and amend_adr. No
# prompts, no ssh, no clock. scripts/test-c1-c9-verdicts extracts exactly this
# span and drives it, so the chain is exercised without a phone. Keep it pure.

# ── C1 ────────────────────────────────────────────────────────────────────
if [[ "$C1_SCREEN" != a ]]; then
  record_result C1 "Not observable" \
    "First run had already been consumed on this device. It shows once ever, the Keychain record outlives app deletion (ADR 0002), and clean slate deliberately does not reset it (ADR 0008), so there is no route back to that screen" \
    "None — but the sentence carrying all of this app's informed consent cannot be re-observed on a phone that has run it. C1 needs a device that never has"
  FOLLOWUP+=("C1 needs a phone that has never run freedomfrom, or an erased one")
elif [[ "$C1_SENTENCE" =~ ^[Yy] && "$C1_PROMPT" =~ ^[Yy] ]]; then
  detail="The consent sentence was on screen before anything was committed, and iOS asked for Screen Time access on 'Begin'"
  [[ -n "$auth" ]] && detail="$detail. \`app\` logs \`authorization state=$auth\` afterwards"
  record_result C1 "**Green**" "$detail" "None"
else
  reason="the authorization prompt did not appear"
  [[ "$C1_SENTENCE" =~ ^[Nn] ]] && reason="the consent sentence was not on the first-run screen"
  record_result C1 "**Red**" \
    "First run was reached, but $reason" \
    "None bound — ADR 0003 rests informed consent on that screen, and a first run that does not state the cost is a decision to re-take rather than an amendment to apply"
  FOLLOWUP+=("C1 red: first run did not state what it costs. ADR 0003 needs re-opening, not amending")
fi

# ── C2 ────────────────────────────────────────────────────────────────────
# The log decides, and the human's answer breaks the tie it cannot. An app that
# opens normally is usually an app with no shield on it — but iOS launches
# ShieldConfig only while the shield is up, so a `woke reason=shielding` line is
# proof the target was blocked at the moment of the tap.
if was_expired C2; then
  expired_note C2
elif [[ "$C2_SHIELD" == a && "$enforcement" == yes ]]; then
  record_result C2 "**Green**" \
    "Apple's shield replaced the app, and \`app\` logs \`store mutation enforcement landed=true\`${cov:+ with \`$cov\`}${sc_woke:+}. **The shield on screen is the human's answer, not a log line** — \`shieldconfig\` waking corroborates it, since iOS launches that extension only while a shield is up" \
    "None"
elif [[ "$C2_SHIELD" == a && "$enforcement" == no ]]; then
  record_result C2 "Inconclusive, re-run" \
    "A shield was seen but no \`store mutation enforcement landed=true\` line is in the archive, so what drew it cannot be attributed to this commitment" \
    "None — not a result"
elif [[ "$enforcement" == no ]]; then
  record_result C2 "Inconclusive, re-run" \
    "No shield, and enforcement was never logged as applied. Nothing was under test" \
    "None — not a result"
else
  detail="Enforcement applied${cov:+ (\`$cov\`)}, but the target opened with no shield"
  [[ "$C2_SHIELD" == c ]] && detail="$detail; it flashed and returned to the Home Screen"
  [[ "$sc_woke" == yes ]] && detail="$detail. \`shieldconfig\` did wake, so a shield existed at the moment of the tap"
  record_result C2 "**Red**" "$detail" \
    "None bound — the shield not applying is not a failure this checklist pre-decided, because every other check assumes it"
  FOLLOWUP+=("C2 red: the shield did not apply. Nothing downstream of it is meaningful")
fi

# ── C3a ───────────────────────────────────────────────────────────────────
# The gate. Four ways this can go and only one of them is the amendment: a
# domain that would not load anyway proves nothing, enforcement that never
# applied proves nothing, and a policy that never landed is a bug rather than a
# fact about iOS. C5 is what separates the last two.
if was_expired C3a; then
  expired_note C3a
elif [[ "$C3A_CONTROL" =~ ^[Nn] ]]; then
  record_result C3a "Inconclusive, re-run" \
    "The control domain \`$CONTROL_DOMAIN\` did not load either, so the phone had no working network and a refused page is not evidence of a filter" \
    "None — not a result"
elif [[ "$enforcement" == no ]]; then
  record_result C3a "Inconclusive, re-run" \
    "Enforcement was never logged as applied, so the filter this check is about was never written" \
    "None — not a result"
elif [[ "$C3A_BLOCKED" =~ ^[Yy] ]]; then
  record_result C3a "**Green**" \
    "Safari refused \`$C_DOMAIN\` while the control \`$CONTROL_DOMAIN\` loaded normally, with \`store mutation enforcement landed=true\` in the archive" \
    "None"
elif [[ -z "${C5_PRIVATE:-}" ]]; then
  # C5 is the other half of this gate's evidence, and the run did not get it:
  # normally because the deadline passed before C5 was reached, so it was never
  # asked.
  #
  # Falling through to the red branch on that would fire ADR 0006's amendment
  # and delete the web half of v1 on a run that never looked at the one
  # observation separating "the filter landed and does nothing" from "the
  # policy never reached the device". A gate scored on half its evidence is
  # worse than an unscored gate, because the amendment is not reversible by
  # noticing later.
  record_result C3a "Inconclusive, re-run" \
    "\`$C_DOMAIN\` loaded and the control \`$CONTROL_DOMAIN\` loaded, but C5 was never reached, so nothing separates a filter that landed and blocks nothing from a policy that never reached the device. The gate is not scored on half its evidence" \
    "None — not a result"
  FOLLOWUP+=("C3a needs a re-run that reaches C5: the gate cannot be scored without it")
elif [[ "$C5_PRIVATE" =~ ^[Nn] ]]; then
  # Applied, but Private Browsing is still there — so the policy did not land on
  # the device at all, whatever the call returned. `landed=true` means the call
  # completed, never that the setting governs anything (ADR 0005).
  record_result C3a "Inconclusive, re-run" \
    "\`$C_DOMAIN\` loaded, and Private Browsing was still available — so the web-content policy did not reach the device at all, whatever the mutation call returned. A bug in \`Enforcement\`, not a fact about \`.specific\`" \
    "None — not a result"
  FOLLOWUP+=("C3a inconclusive with C5 red: the web-content policy is not reaching the device. Diagnose Enforcement before re-running")
else
  printf '  %s✗ RED%s — the filter is inert. The gate fires.\n' "$RED" "$RESET"
  record_result C3a "**Red**" \
    "\`$C_DOMAIN\` loaded normally in Safari while the control also loaded, enforcement was logged as applied, and Private Browsing was unavailable — so the policy reached the device and blocked nothing" \
    "**Fired.** [ADR 0006](./adr/0006-web-targets-block-by-filter-not-by-shield.md) amended: web targets leave v1"

  amend_adr "0006-web-targets-block-by-filter-not-by-shield.md" \
    "## Amended by hardware: web targets leave v1" <<'ADR0006'
> Hardware smoke check C3a came back **red**. A `.specific` web-content filter
> does not refuse a typed domain in Safari on a device: the page loaded, a
> control domain that was never typed also loaded, the archive holds
> `store mutation enforcement landed=true`, and Private Browsing was
> unavailable — so the policy reached the device and blocked nothing.

**Web targets leave v1.** The targets step keeps the app picker and loses the
domain field. The history loses the only thing it could say in words.
`blockedByFilter` and the 50-domain rule come out of enforcement. `WebDomain`
canonicalization stays in the kit, unused, because it is pure string logic and
costs nothing to keep against a v2 that finds another mechanism.

This is the option listed above as not offered, arrived at by evidence rather
than by preference. **The fallback is deletion and not the option rejected above
it.** Picker tokens on the shield were rejected on what they cost — the targets
screen collapses to an opaque count, which deletes the only words in the app and
the only thing the history can name — and their cold-site selection is itself
UNVERIFIED. Swapping an inert mechanism for an unproven one on the strength of
one afternoon is how a smoke run becomes a redesign, and that was decided before
this check was walked precisely so it could not be re-decided while standing
over a phone.

Two things follow that this ADR would not have chosen. **The 50-domain ceiling,
the canonicalization rules, and the Private Browsing sentence all become
unreachable at once**, so the targets step loses its only web-specific line and
first run is unchanged, which is where ADR 0003 had it. And **a commitment is
once again exactly a shield**: the generalization this ADR made to ADR 0005 —
that a commitment exists if its enforcement applied, not if its shield did —
survives as written but has nothing left to cover.
ADR0006
fi

# ── C3b ───────────────────────────────────────────────────────────────────
if was_expired C3b; then
  expired_note C3b
elif was_expired C3a; then
  # C3a itself was reached late, so the survey was skipped rather than run out
  # of time on its own. It never called check_open, so it is not in EXPIRED and
  # C3A_BLOCKED was never set.
  record_result C3b "Not reached" \
    "C3a was reached after the deadline and was not asked, so there was no coverage to survey" \
    "None — not a result"
elif [[ "$C3A_BLOCKED" =~ ^[Yy] && "$C3A_CONTROL" =~ ^[Yy] ]]; then
  browsers="Safari **blocked**"
  for pair in "Chrome:$C3B_CHROME" "Firefox:$C3B_FIREFOX" "Brave:$C3B_BRAVE" "in-app WKWebView:$C3B_WEBVIEW"; do
    name="${pair%%:*}"; answer="${pair#*:}"
    case "$answer" in
      [Yy]*) browsers="$browsers; $name **blocked**" ;;
      [Nn]*) browsers="$browsers; $name loaded it" ;;
      *)     browsers="$browsers; $name not installed" ;;
    esac
  done
  record_result C3b "Survey" "$browsers" \
    "The targets step names only the browsers that blocked, and never generalizes"
else
  record_result C3b "Not reached" \
    "C3a did not come back green, so there was no coverage to survey" \
    "None — not a result"
fi

# ── C4 ────────────────────────────────────────────────────────────────────
if was_expired C4; then
  expired_note C4
elif was_expired C3a; then
  record_result C4 "Not reached" \
    "C3a was reached after the deadline and was not asked, so there was no matching rule to probe" \
    "None — not a result"
elif [[ "$C3A_BLOCKED" =~ ^[Yy] && "$C3A_CONTROL" =~ ^[Yy] ]]; then
  case "$C4_WWW" in
    [Yy]*) www="\`www.$C_DOMAIN\` was refused" ;;
    *)     www="\`www.$C_DOMAIN\` loaded" ;;
  esac
  case "$C4_M" in
    [Yy]*) sub="$www; \`m.$C_DOMAIN\` was refused" ;;
    [Nn]*) sub="$www; \`m.$C_DOMAIN\` loaded" ;;
    *)     sub="$www; \`m.$C_DOMAIN\` does not exist, so it was not probed" ;;
  esac
  if [[ "$C4_WWW" =~ ^[Yy] ]]; then
    # Licensed to exactly the hosts that were probed, which is the point of
    # naming them. The row used to authorise "a bare domain covers its
    # subdomains" off a run that had refused `www.` and skipped `m.` because it
    # did not exist — a rule from one example. That wording reached the app and
    # review caught it there rather than here.
    covered="\`www.\`"
    [[ "$C4_M" =~ ^[Yy] ]] && covered="\`www.\` and \`m.\`"
    record_result C4 "Subdomains covered" "$sub" \
      "The targets step may now say a bare domain covers $covered, naming only what was probed. Canonicalization is unchanged either way"
  else
    record_result C4 "Subdomains not covered" "$sub" \
      "Canonicalization stands unchanged (ADR 0006 refuses to guess at matching rules) and the user types each host"
  fi
else
  record_result C4 "Not reached" \
    "C3a did not come back green, so there was no matching rule to probe" \
    "None — not a result"
fi

# ── C5 ────────────────────────────────────────────────────────────────────
if was_expired C5; then
  expired_note C5
elif [[ "$C5_PRIVATE" =~ ^[Yy] ]]; then
  record_result C5 "**Green**" \
    "Private Browsing was unavailable in Safari's tab switcher while the filter was applied" "None"
elif [[ "$enforcement" == no ]]; then
  record_result C5 "Inconclusive, re-run" \
    "Enforcement was never logged as applied, so nothing should have suppressed it" \
    "None — not a result"
else
  record_result C5 "**Red**" \
    "Private Browsing was still available while enforcement was logged as applied, so the web-content policy did not reach the device" \
    "None bound — Apple documents this as a consequence of filtering, so its absence means the policy did not land rather than that the documentation is wrong"
  FOLLOWUP+=("C5 red: the web-content policy is not reaching the device. This is an Enforcement bug, and C3a cannot be scored until it is fixed")
fi

# ── C6 ────────────────────────────────────────────────────────────────────
# No log line corroborates either half. There is no read-back of effective state
# anywhere in ManagedSettings, so the row says whose observation it is.
witness="The human's observation. There is no read-back of effective state (ADR 0005), so no log line corroborates either half"
if was_expired C6; then
  expired_note C6
elif [[ -z "${C6_DELETE:-}" || -z "${C6_CLOCK:-}" ]]; then
  # Both halves are the human's eyes and nothing else, so an unanswered half has
  # no log line to fall back on. It reads as `^[Yy]` failing, which is a
  # refusal that did not happen — and that scores red and rewrites the app's
  # one sentence about informed consent.
  record_result C6 "Inconclusive, re-run" \
    "One or both halves went unanswered. This check has no log line to fall back on — there is no read-back of effective state anywhere in \`ManagedSettings\` (ADR 0005) — so an unanswered half is not a failed one" \
    "None — not a result"
  FOLLOWUP+=("C6 was not fully answered, and it is the check informed consent rests on")
elif [[ "$C6_DELETE" =~ ^[Yy] && "$C6_CLOCK" =~ ^[Yy] ]]; then
  record_result C6 "**Green**" \
    "Deleting another app was refused, and 'Set Automatically' could not be switched off. $witness" "None"
else
  kept="neither claim"
  [[ "$C6_DELETE" =~ ^[Yy] ]] && kept="the deletion claim only"
  [[ "$C6_CLOCK" =~ ^[Yy] ]] && kept="the clock claim only"
  record_result C6 "**Red**" \
    "The first-run sentence keeps $kept: app deletion was $([[ "$C6_DELETE" =~ ^[Yy] ]] && echo refused || echo allowed), and the automatic clock was $([[ "$C6_CLOCK" =~ ^[Yy] ]] && echo locked || echo switchable). $witness" \
    "**Fired.** [ADR 0003](./adr/0003-a-wordless-v1-flow.md) amended: the consent sentence drops what it cannot keep"

  if [[ ! "$C6_DELETE" =~ ^[Yy] ]] && [[ ! "$C6_CLOCK" =~ ^[Yy] ]]; then
    amend_adr "0003-a-wordless-v1-flow.md" \
      "## Amended by hardware: the consent sentence drops both claims" <<'ADR0003BOTH'
> Hardware smoke check C6 came back **red on both halves**. Under `.individual`
> authorization, `denyAppRemoval` did not stop another app being deleted and
> `requireAutomaticDateAndTime` did not stop the clock being switched to manual.

The first-run sentence loses the whole of its second clause. It states what a
commitment blocks and for how long, and nothing about the rest of the phone,
because there is nothing true left to say about it.

This is the worst version of this check's outcome and it is worth being blunt
about what it costs: **the device-wide restrictions were the strongest thing v1
had.** Without them a commitment is a shield and a filter, and the clock can be
moved to walk past a deadline. ADR 0004's absolute deadline is what limits that
damage — a commitment ends at a stored instant, not after a counted duration, so
a moved clock changes when the release is noticed and not whether it arrives.

**No new screen and no new words replace them.** ADR 0001 builds no lever, and a
sentence that claimed protection it does not have was the one thing this ADR's
whole design could not survive. Saying less is the amendment.
ADR0003BOTH
  elif [[ ! "$C6_DELETE" =~ ^[Yy] ]]; then
    amend_adr "0003-a-wordless-v1-flow.md" \
      "## Amended by hardware: the consent sentence drops the deletion claim" <<'ADR0003DELETE'
> Hardware smoke check C6 came back **red on its first half**. Under
> `.individual` authorization, `denyAppRemoval` did not stop another app being
> deleted. The clock restriction held.

The first-run sentence loses "no app on this phone can be deleted — not just
this one" and keeps the clock. It now states what a commitment blocks, for how
long, and that the clock stays automatic.

This was the most surprising consequence of committing and the reason that
sentence was at full weight rather than in whisper type. Losing it makes first
run quieter and more honest at once. It also removes the one protection that
made deleting freedomfrom mid-commitment hard, which is check X3's business in
the sacrificial run: re-arming after a reinstall is now the only thing standing
between a commitment and an uninstall.
ADR0003DELETE
  else
    amend_adr "0003-a-wordless-v1-flow.md" \
      "## Amended by hardware: the consent sentence drops the clock claim" <<'ADR0003CLOCK'
> Hardware smoke check C6 came back **red on its second half**. Under
> `.individual` authorization, `requireAutomaticDateAndTime` did not stop the
> clock being switched to manual. The deletion restriction held.

The first-run sentence loses "and the clock stays automatic". It now states what
a commitment blocks, for how long, and that no app on the phone can be deleted
while it runs.

What this costs is smaller than it looks, and ADR 0004 is why. A commitment ends
at an absolute stored instant rather than after a counted duration, so moving
the clock forward does not shorten one — it only changes when a reconciliation
notices the deadline has passed, and the direction of that error is late rather
than early. The restriction was defence in depth, and the depth it defended is
still there.
ADR0003CLOCK
  fi
  FOLLOWUP+=("C6 red: the first-run copy in FirstRunView.swift has to drop the claim the amendment dropped")
fi

# ── C7 ────────────────────────────────────────────────────────────────────
# Arithmetic rather than a judgement. The countdown states resolved + domains
# over named + domains; the log states only the app half, and the domain half is
# one, because this run typed one.
if was_expired C7; then
  expired_note C7
elif [[ -n "$cov_resolved" && -n "$cov_named" ]]; then
  expect_resolved=$(( cov_resolved + 1 ))
  expect_named=$(( cov_named + 1 ))
  expected="$expect_resolved of $expect_named covered"
  note "the log says the app half is $cov_resolved of $cov_named"
  note "one domain was typed, so the countdown should read: $expected"
  note "you read: $C7_READS"
  if [[ "$C7_READS" == *"$expect_resolved of $expect_named"* ]]; then
    record_result C7 "**Green**" \
      "The countdown read \`$C7_READS\`, which is the \`$cov\` in the archive plus the one typed domain. It states what was enforced, not what was named" \
      "None"
  else
    record_result C7 "**Red**" \
      "The countdown read \`$C7_READS\`, but the archive holds \`$cov\` and one domain was typed, so it should have read \`$expected\`" \
      "None bound — coverage is the substitute for every message the app refuses to show (ADR 0005), so a coverage line that is wrong is a bug and not a decision"
    FOLLOWUP+=("C7 red: the countdown's stated coverage disagrees with the log")
  fi
else
  record_result C7 "Inconclusive, re-run" \
    "No \`coverage resolved= of named=\` line in the archive, so there is nothing to check the screen against" \
    "None — not a result"
fi

# ── C8 ────────────────────────────────────────────────────────────────────
if [[ "$released" == yes && "$C8_LIFTED" =~ ^[Yy] && "$C8_HISTORY" == a && "$C8_DOMAIN_FREE" =~ ^[Yy] ]]; then
  record_result C8 "**Green**, late by ${late_by}s" \
    "Enforcement lifted with the app closed and the domain loaded again, and the history row reads completed. \`released late_by_seconds=$late_by\` in the archive" \
    "None"
elif [[ "$released" == yes && "$C8_LIFTED" =~ ^[Yy] && "$C8_HISTORY" == a ]]; then
  # The app came back and the domain did not. `releaseEverything` unsets the
  # shield and the filter in one call, so a half-lifted release is the same
  # shape as C5 red: the mutation returned and the setting still governs the
  # device. Safari also caches the block page, which is an innocent explanation
  # of the same screen — so this is a re-run rather than a red.
  record_result C8 "Inconclusive, re-run" \
    "\`released late_by_seconds=$late_by\` is in the archive and the app opened normally, but \`$C_DOMAIN\` was still refused afterwards. Release unsets the shield and the filter in one call, so either the filter did not lift or Safari served a cached block page" \
    "None — not a result"
  FOLLOWUP+=("C8 half-lifted: the app came back and the domain did not. Re-run against a cleared Safari cache, and if it holds, the release is not clearing blockedByFilter")
elif [[ "$released" == no ]]; then
  record_result C8 "**Red**" \
    "No \`released late_by_seconds=\` line in the archive$([[ "$C8_LIFTED" =~ ^[Yy] ]] && echo ", though the app opened normally — so something lifted the shield without logging it")" \
    "None bound — a release that never arrives is what ADR 0004's whole walk-forward watchdog exists to prevent, and a red here reopens it rather than amending it"
  FOLLOWUP+=("C8 red: no release was logged. ADR 0004's watchdog needs re-opening")
else
  detail="\`released late_by_seconds=$late_by\` is in the archive"
  [[ ! "$C8_LIFTED" =~ ^[Yy] ]] && detail="$detail, but the app was still shielded on the next open"
  [[ ! "$C8_DOMAIN_FREE" =~ ^[Yy] ]] && detail="$detail, and \`$C_DOMAIN\` was still refused"
  [[ "$C8_HISTORY" == b ]] && detail="$detail, and the history row reads broken rather than completed"
  [[ "$C8_HISTORY" == c ]] && detail="$detail, and no history row was written"
  record_result C8 "Inconclusive, re-run" "$detail" "None — not a result"
fi

# <<< verdicts end

pause

# ── 15 ────────────────────────────────────────────────────────────────────
stage "What this run produced"
say "Results table rows written into docs/hardware-smoke-checklist.md:"
for r in "${RECORDED[@]}"; do note "  $r"; done
say ""
if (( ${#AMENDED[@]} )); then
  say "ADRs amended in place:"
  for a in "${AMENDED[@]}"; do note "  $a"; done
else
  note "No amendment fired."
fi
say ""
if (( ${#FOLLOWUP[@]} )); then
  say "Work this run created, which nothing here has filed:"
  for f in "${FOLLOWUP[@]}"; do note "  - $f"; done
  note "Each one wants an issue on the v1 milestone. Read the rows before filing:"
  note "  gh issue create --milestone v1 --label ready-for-agent"
  say ""
fi
say "Evidence saved beside the checklist:"
note "  docs/evidence/c1-c9.log               every line from this subsystem"
note "  docs/evidence/c1-c9-app.log           the app"
note "  docs/evidence/c1-c9-monitor.log       the watchdog"
note "  docs/evidence/c1-c9-shieldconfig.log  the extension that draws the shield"
note "  docs/evidence/answers-c1-c9.env       what you reported seeing"
note "The .logarchive itself stays on $HOST at ~/$MAC_EVIDENCE, being far too large to commit."
say ""
say "Review the diff before committing it. Nothing here is worth more than its evidence."

finish
