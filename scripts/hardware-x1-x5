#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES
#
# The sacrificial hardware run, X1 through X5 (docs/hardware-smoke-checklist.md,
# issue #32).
#
# One longer commitment, deliberately broken, observed to its deadline. It is a
# second commitment because everything here marks it, and a mark contaminates
# every observation the clean run is for.
#
# The order inside the run is forced: **revoke before deleting**, because a
# working `denyAppRemoval` prevents deleting the app at all.
#
# Two things are different here from the clean run, and both come from #54.
#
# The app marks a running commitment broken on any cold launch, because it
# judges on an `authorizationStatus` that has not settled yet. So the commitment
# will already be marked before anybody revokes anything, and **no check here
# can attribute a mark to the thing it was meant to be testing**. Every verdict
# below is worded for what survives that: a deadline that never moves, a mark
# recorded once rather than once per launch, and a reinstall that finds the
# commitment and re-arms.
#
# And the run's most valuable output is not a verdict at all. X1a reads what
# `authorizationStatus` says after a real revoke, from a **settled** read rather
# than a launch-time one, and that single fact is what #54's fix turns on.
# Getting it is why this run is worth walking now rather than after the bug is
# closed.
#
# What this script will not do, in common with the clean run's wizard: it will
# not score a run that was not clean, and it will not fill in a row it did not
# observe.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=12

# Overridable in the same names scripts/mac uses, so one export covers both.
HOST="${FREEDOMFROM_MAC_HOST:-mac}"
MAC_ROOT="${FREEDOMFROM_MAC_ROOT:-builds/freedomfrom}"
DEVICE="${FREEDOMFROM_DEVICE:-7EE3550E-8A48-5192-B729-961CB3FD51E9}"
SIGN_SOCKET="${FREEDOMFROM_SIGN_SOCKET:-$HOME/.ssh/cm/mac-sign}"

# `devicectl --device` takes the CoreDevice UUID above; `log collect
# --device-udid` takes the ECID-derived hardware UDID. Resolved in preflight
# rather than written down, so a second phone needs no edit here.
DEVICE_UDID="${FREEDOMFROM_DEVICE_UDID:-}"

SUBSYSTEM=com.samuelcolacchia.freedomfrom
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHECKLIST="$REPO/docs/hardware-smoke-checklist.md"
EVIDENCE="$REPO/docs/evidence"
ADR="$REPO/docs/adr"

MAC_EVIDENCE="$MAC_ROOT/evidence"
ARCHIVE="\$HOME/$MAC_EVIDENCE/x1-x5.logarchive"

# Long enough to revoke, be prompted, delete, reinstall, and still have the
# deadline ahead of you, and short enough that X5 is a wait rather than an
# afternoon. The app's own minimum is fifteen minutes (ADR 0004).
LENGTH_MINUTES="${FREEDOMFROM_X_MINUTES:-40}"

ENV_FILE="$EVIDENCE/answers-x1-x5.env"
AMENDED=()
RECORDED=()
FOLLOWUP=()
EXPIRED=()

mkdir -p "$EVIDENCE"

# ── Helpers particular to this wizard ─────────────────────────────────────

# remote_sh runs a script on the Mac, arriving on stdin so nothing is quoted
# twice. Password-free: every command here reads.
remote_sh() { ssh -o BatchMode=yes "$HOST" bash -s; }

# log_for CATEGORY prints this run's lines for one process. One category per
# process is what keeps "the extension never woke" distinguishable from "it woke
# and found nothing" (ADR 0009).
log_for() {
  remote_sh <<EOF 2>/dev/null || true
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM" AND category == "$1"' \\
  --info --debug --style compact
EOF
}

# deadline_epoch HH:MM turns a wall-clock time into an epoch second, rolling to
# tomorrow only when today's would be more than twelve hours past.
#
# The shape is checked before date(1) sees it, because date(1) is not a
# validator: `date -d "today 14m"` succeeds and silently means something else.
deadline_epoch() {
  local at now
  [[ "$1" =~ ^([01][0-9]|2[0-3]|[0-9]):[0-5][0-9](:[0-5][0-9])?$ ]] || return 1
  at=$(date -d "today $1" +%s 2>/dev/null) || return 1
  [[ -n "$at" ]] || return 1
  now=$(date +%s)
  (( at < now - 43200 )) && at=$(( at + 86400 ))
  printf '%s' "$at"
}

# still_running succeeds while the commitment's deadline is in the future.
still_running() {
  [[ -n "${DEADLINE_AT:-}" ]] || return 0
  (( $(date +%s) < DEADLINE_AT ))
}

# budget prints what is left, so the human can pace the middle of the run.
budget() {
  local left
  [[ -n "${DEADLINE_AT:-}" ]] || return 0
  left=$(( DEADLINE_AT - $(date +%s) ))
  if (( left > 0 )); then
    note "$(printf '%d:%02d' $(( left / 60 )) $(( left % 60 ))) left on the commitment"
  else
    warn "the commitment has already ended. Anything below is asked of an unenforced phone."
  fi
}

# check_open CHECK succeeds while there is still a commitment to observe. X1
# through X4 are all asked of a running commitment — a revoke with nothing to
# revoke from, or a reinstall that finds nothing to re-arm, is a different
# question with the same words.
check_open() {
  still_running && return 0
  warn "$1 was reached after the deadline, so there is no commitment under it."
  note "It is not asked. A revoke, a reinstall or a coverage line observed now"
  note "describes a phone with nothing running on it, which is not this row."
  EXPIRED+=("$1")
  return 1
}

was_expired() {
  local c
  for c in ${EXPIRED[@]+"${EXPIRED[@]}"}; do [[ "$c" == "$1" ]] && return 0; done
  return 1
}

expired_note() {
  record_result "$1" "Inconclusive, re-run" \
    "The commitment released before this check was reached, so there was nothing running to observe it against and it was not asked" \
    "None — not a result"
}

# observe KEY "Prompt" reads an observation and stores it.
#
# Unlike ask, it never offers the previous run's answer as a default. A stored
# answer to "was there a prompt?" is the shortest path there is to a row nobody
# looked at, and keeping those out of the table is what this whole procedure is.
#
# It also re-asks a blank, until there is nobody left to ask, because every
# verdict below reads its answer against `^[Yy]` and an empty string is not a
# missing answer to that test — it is a "no".
observe() {
  local key="$1" prompt="$2" input
  while :; do
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
    if ! read -r input; then
      warn "no more input, so this is left unanswered."
      input=""
      break
    fi
    [[ -n "$input" ]] && break
    warn "That needs an answer. A blank reads as 'no' to every test below, and a"
    warn "row written from one is a row nobody looked at."
  done
  printf -v "$key" '%s' "$input"
  write_env "$key" "$input"
}

# wait_until EPOCH holds the human here until the deadline has actually passed.
wait_until() {
  local at="$1" now left
  while :; do
    now=$(date +%s)
    (( now >= at )) && break
    left=$(( at - now ))
    if [[ -t 1 ]]; then
      printf '\r  %swaiting %02d:%02d for the deadline…%s\033[K' \
        "$DIM" $(( left / 60 )) $(( left % 60 )) "$RESET"
    fi
    sleep 1
  done
  [[ -t 1 ]] && printf '\r\033[K'
  printf '  %s✓%s the deadline has passed.\n' "$GREEN" "$RESET"
}

# line_epoch LINE prints the epoch second of a compact-style log line, or
# nothing when the line does not start with a timestamp.
#
# Every fact this run turns into a row is "did this happen before or after that
# tap", so the timestamps are load-bearing rather than decorative: the whole of
# X1b is one comparison between when the mark landed and when the human revoked.
line_epoch() {
  [[ "$1" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})\ ([0-9]{2}:[0-9]{2}:[0-9]{2}) ]] || return 1
  date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" +%s 2>/dev/null
}

# since EPOCH < lines: the lines stamped at or after EPOCH.
since() {
  local at="$1" line ts
  while IFS= read -r line; do
    ts=$(line_epoch "$line") || continue
    (( ts >= at )) && printf '%s\n' "$line"
  done
}

# first_epoch PATTERN < lines: when the first matching line landed.
first_epoch() {
  local line
  while IFS= read -r line; do
    [[ "$line" == *"$1"* ]] || continue
    line_epoch "$line" && return 0
  done
  return 1
}

# auth_reads < lines: one `reason state` pair per authorization read, carrying
# the wake that preceded it.
#
# The wake is the whole point. A read taken on a cold launch is the unsettled
# one #54 is about; a read taken on a foreground is a process that has been
# alive, and only that one answers what a revoke actually leaves the status as.
auth_reads() {
  awk '
    /woke reason=/ {
      match($0, /reason=[a-z-]+/)
      reason = substr($0, RSTART + 7, RLENGTH - 7)
    }
    /authorization state=/ {
      match($0, /state=.*$/)
      print reason, substr($0, RSTART + 6)
    }
  '
}

# record_result CHECK RESULT EVIDENCE AMENDMENT rewrites one row of the results
# table in place, found by its check id. Column 2 — what the check decides — is
# never touched, and re-running overwrites rather than appending.
#
# A pipe in a cell becomes `&#124;` rather than `\|`. Both render as a pipe, but
# a backslash-escaped one is still a pipe to awk, so a cell containing one would
# split into two on the next run and quietly push the amendment into a seventh
# column.
record_result() {
  local tmp
  tmp=$(mktemp)
  CHECK="$1" RESULT="${2//|/\&#124;}" CELL="${3//|/\&#124;}" AMEND="${4//|/\&#124;}" \
    awk '
      BEGIN { FS = "|"; OFS = "|" }
      function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      NF >= 7 && trim($2) == ENVIRON["CHECK"] {
        $4 = " " ENVIRON["RESULT"] " "
        $5 = " " ENVIRON["CELL"] " "
        $6 = " " ENVIRON["AMEND"] " "
        print; next
      }
      { print }
    ' "$CHECKLIST" > "$tmp"
  mv "$tmp" "$CHECKLIST"
  RECORDED+=("$1 → $2")
  printf '  %s✓ recorded%s %s in the results table\n' "$GREEN" "$RESET" "$1"
}

# amend_adr FILE HEADING <<< body appends a pre-written amendment, once.
#
# The wording is fixed here rather than composed at run time because the
# checklist binds an amendment to each check before it runs: a red result
# applies a decision that already exists, and reopening it is the one thing this
# whole procedure is built to prevent.
amend_adr() {
  local file="$ADR/$1" heading="$2" body
  body=$(cat)
  if [[ ! -f "$file" ]]; then
    warn "no such ADR: $1"
    SKIPPED+=("amend $1 by hand")
    return 0
  fi
  if grep -qF "$heading" "$file"; then
    note "already amended: $1"
    return 0
  fi
  printf '\n%s\n\n%s\n' "$heading" "$body" >> "$file"
  AMENDED+=("$1")
  printf '  %s✓ amended%s %s\n' "$GREEN" "$RESET" "$1"
}

# ──────────────────────────────────────────────────────────────────────────

banner "The sacrificial hardware run · X1 through X5"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Preflight: the Mac, the cable, the keychain"
note "One correction to that banner: what you observe is never remembered."
note "Setup answers come back on a re-run; answers about what the phone did are"
note "asked again every time, because a default is how an unlooked-at row gets in."
say ""
warn "This run breaks a commitment on purpose, and one of its steps is the"
warn "Screen Time revoke. Do not walk it on a phone you are relying on."
say ""
say "Three things have to be true before the phone is worth picking up."

if remote_sh <<<'true' 2>/dev/null; then
  printf '  %s✓%s the Mac build host (%s) answers\n' "$GREEN" "$RESET" "$HOST"
else
  warn "cannot reach $HOST over ssh. Nothing below will work; fix that first."
  exit 1
fi

if [[ -S "$SIGN_SOCKET" ]]; then
  printf '  %s✓%s a signing socket exists at %s\n' "$GREEN" "$RESET" "$SIGN_SOCKET"
else
  warn "no signing socket, so the build cannot be signed or installed."
  say "A person at their own shell runs these; the password never enters this session:"
  note "  mkdir -p $(dirname "$SIGN_SOCKET")"
  note "  ssh -o ControlMaster=yes -o ControlPath=$SIGN_SOCKET -o ControlPersist=8h -fN $HOST"
  note "  read -rs pw && printf '%s\\n' \"\$pw\" | ssh -o ControlPath=$SIGN_SOCKET $HOST \\"
  note "    'read -r p; security unlock-keychain -p \"\$p\" ~/Library/Keychains/login.keychain-db'"
  pause "Run those in another shell, then press Enter."
fi

if remote_sh <<EOF | grep -q "$DEVICE"
xcrun devicectl list devices 2>/dev/null
EOF
then
  printf '  %s✓%s the phone (%s) is connected\n' "$GREEN" "$RESET" "$DEVICE"
else
  warn "the phone is not visible to the Mac. Cable it, unlock it, and re-run."
  exit 1
fi

if [[ -z "$DEVICE_UDID" ]]; then
  DEVICE_UDID=$(
    remote_sh <<EOF 2>/dev/null || true
xcrun devicectl device info details --device $DEVICE \\
  --json-output /tmp/freedomfrom-device.json >/dev/null 2>&1 &&
  plutil -extract result.hardwareProperties.udid raw -o - /tmp/freedomfrom-device.json
EOF
  )
  DEVICE_UDID="${DEVICE_UDID//[[:space:]]/}"
fi

if [[ -n "$DEVICE_UDID" ]]; then
  printf '  %s✓%s its hardware UDID is %s\n' "$GREEN" "$RESET" "$DEVICE_UDID"
else
  warn "could not read the hardware UDID, which the log collect line needs."
  note "Read it yourself and export it, then re-run:"
  note "  export FREEDOMFROM_DEVICE_UDID=<the 00008120-… value>"
  exit 1
fi

say ""
say "You will also need, before the commitment is armed:"
step "one app to block that is not freedomfrom, and that you can open freely"
step "the cable to stay in: X3 reinstalls the app from this machine mid-run"
note "No websites are needed. Phase 2 settled the filter; this run is about the"
note "record surviving things that break it."
pause "Ready?"

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Install a clean build"
say "The sacrificial run has to be walked on the build that ships."
say ""
warn "No FREEDOMFROM_HARDWARE_PASS here."
note "That build carries a release control and announces itself on every launch."
note "The capture at X6 is checked for that line, and if it is there no row is"
note "written: a build with a way out of a commitment is not the product."
say ""
warn "This replaces whatever freedomfrom is on the phone."
note "The commitment record lives in the Keychain and survives that (ADR 0002)."

if confirm "Install a clean build on $DEVICE now?"; then
  if "$REPO/scripts/mac" device; then
    printf '  %s✓ installed%s\n' "$GREEN" "$RESET"
  else
    warn "install failed. Read the error above; scripts/mac rawlog has the rest."
    exit 1
  fi
else
  note "skipping the install — assuming a clean build is already on the phone."
  note "The countdown must have no orange 'release · hardware-pass build' row on it."
fi
pause

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Arm the commitment"
say "One app, no domains, and long enough to be broken twice and still be"
say "running: about $LENGTH_MINUTES minutes."
say ""
warn "Nothing else may be running when this starts."
note "X1c counts how many times this commitment is marked broken, and a mark"
note "belonging to an earlier one would be counted against this row. If a"
note "countdown is already on screen, let it end or clean-slate it first."
say ""

if confirm "Is a commitment from an earlier attempt at THIS run still armed?"; then
  warn "Read its deadline off the phone, but check the clocks agree first."
  note "This wizard runs here, not on the phone, and turns the time you type into"
  note "an instant using THIS machine's clock and time zone."
  note "  here, it is now $(date '+%H:%M:%S %Z')"
  say ""
  DEADLINE_AT=""
  while :; do
    ask X_DEADLINE "What wall-clock time does it end? (24h, e.g. 14:35)"
    if DEADLINE_AT=$(deadline_epoch "$X_DEADLINE"); then
      write_env X_DEADLINE "$X_DEADLINE"
      note "reading that as $(date -d "@$DEADLINE_AT" '+%F %H:%M:%S %Z')"
      break
    fi
    DEADLINE_AT=""
    warn "'$X_DEADLINE' is not a clock time. Answer like 14:35."
    confirm "Skip the check and judge the wait yourself?" && break
  done
  # Unknown, and it must not be guessed: X1b compares the mark against this, and
  # a commit time invented here would date a mark to the wrong side of a tap.
  COMMIT_AT=""
else
  step "On Targets, tap 'Choose apps' and check exactly ONE app — not freedomfrom."
  note "  Pick something you can open freely."
  step "Dismiss the picker. The count above should read 1."
  step "Tap 'Next', then the last row, 'a date…'."
  step "Set it about $LENGTH_MINUTES minutes from now and tap Done."
  note "  The list of presets jumps from 15 minutes to an hour, and this run needs"
  note "  neither. The date picker is the only way to a length between them."
  say ""
  step "Read the 'until …' line under the list. That is the deadline."
  step "Hold to commit. You should land on the countdown."
  pause "Press Enter the moment the countdown appears."

  COMMIT_AT=$(date +%s)
  write_env X_COMMIT_AT "$COMMIT_AT"

  DEADLINE_AT=""
  while :; do
    ask X_DEADLINE "What did the 'until' line say? (24h clock, e.g. 14:35)"
    if DEADLINE_AT=$(deadline_epoch "$X_DEADLINE"); then
      write_env X_DEADLINE "$X_DEADLINE"
      note "reading that as $(date -d "@$DEADLINE_AT" '+%F %H:%M:%S %Z')"
      if (( DEADLINE_AT <= COMMIT_AT )); then
        warn "that is not in the future. Read it again."
        DEADLINE_AT=""
        continue
      fi
      break
    fi
    DEADLINE_AT=""
    warn "'$X_DEADLINE' is not a clock time. Answer like 14:35."
    confirm "Skip the check and judge the wait yourself?" && break
  done
fi

say ""
warn "There is a clock on the rest of this run now."
note "X1 through X4 are asked of a running commitment. Once the deadline passes"
note "there is nothing to revoke from and nothing to re-arm, so anything reached"
note "late is recorded as inconclusive rather than scored."
budget
pause

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "X1 · Before the revoke"
budget
say "Nothing is broken yet. This is the reading the rest of X1 is measured from."
say ""
if check_open X1; then
  step "Open freedomfrom and look at the countdown."
  observe X1_RUNNING_BEFORE "Is a timer counting down? (y/n)"
  observe X1_COVERAGE_BEFORE "What does the line under it say, exactly? (e.g. '1 of 1 covered')"
  say ""
  note "Leave the app open and switch away from it rather than killing it."
  note "The next step needs a foreground, not a launch, and that distinction is"
  note "the whole of X1a."
fi
pause

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "X1 · The revoke"
budget
say "This is the one route out of a commitment that the app cannot close, and"
say "naming it plainly is what the Escape screen does (ADR 0001)."
say ""
if check_open X1; then
  step "Settings → Screen Time → freedomfrom → turn off Screen Time access."
  say ""
  pause "Press Enter the moment the revoke has gone through."
  REVOKE_AT=$(date +%s)
  write_env X_REVOKE_AT "$REVOKE_AT"
  note "revoke stamped at $(date -d "@$REVOKE_AT" '+%H:%M:%S')"
  say ""
  warn "Now switch BACK to freedomfrom without killing it first."
  note "A cold launch reads an authorization status that has not settled yet"
  note "(#54), and a read like that cannot tell a revoke from a fresh process."
  note "A foreground is a process that has been alive, so its read is the one"
  note "that answers what a revoke actually leaves behind."
  say ""
  step "Switch back to freedomfrom from the app switcher."
  observe X1_RUNNING_AFTER "Is the timer still counting down? (y/n)"
  say ""
  note "Whether the mark landed, when it landed, and what the status read are all"
  note "taken from the archive at the end. None of them is asked of you here."
fi
pause

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "X2 · Does it prompt again after a revoke?"
budget
say "The app re-requests authorization on every launch and foreground while a"
say "commitment runs, so that a moment of weakness does not end a month of it."
say ""
say "Whether iOS honours that from a revoked state is what this asks."
say ""
if check_open X2; then
  observe X2_PROMPT "Did iOS ask for Screen Time access when you came back? (y/n)"
  if [[ "$X2_PROMPT" =~ ^[Yy] ]]; then
    step "Grant it. X3 and X4 both need enforcement live again."
    observe X2_GRANTED "Granted? (y/n)"
  else
    warn "No prompt. ADR 0005 pre-decided this: it degrades into the never-ask"
    warn "option at the cost of one wasted call per launch. Recorded, not fixed."
    X2_GRANTED=n
    write_env X2_GRANTED n
    say ""
    note "X4 reads the shield, and there will not be one on an unauthorized phone,"
    note "so it will come back inconclusive rather than red. That is correct."
  fi
fi
pause

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "X3 · Delete and reinstall"
budget
say "This is why the revoke had to come first: a working denyAppRemoval stops"
say "the app being deleted at all, which C6 observed holding."
say ""
say "What this row is for is the record outliving deletion. The Keychain is the"
say "only thing in this design that does, and everything else rests on it."
say ""
if check_open X3; then
  step "Delete freedomfrom from the Home Screen."
  observe X3_DELETED "Did it delete? (y/n)"
  if [[ "$X3_DELETED" =~ ^[Yy] ]]; then
    say ""
    say "Reinstalling from this machine."
    if "$REPO/scripts/mac" device; then
      printf '  %s✓ reinstalled%s\n' "$GREEN" "$RESET"
    else
      warn "reinstall failed. Read the error above."
      note "The commitment is still in the Keychain and still running; the phone"
      note "simply has no app for it. Fix the install and re-run this stage."
      exit 1
    fi
    REINSTALL_AT=$(date +%s)
    write_env X_REINSTALL_AT "$REINSTALL_AT"
    say ""
    step "Open freedomfrom."
    say ""
    say "What did it land on?"
    note "  a  a countdown, still running"
    note "  b  first run — 'Begin'"
    note "  c  Targets"
    observe X3_SCREEN "a / b / c:"
  else
    warn "It would not delete, so X3 cannot be walked and X4 has no reinstall to"
    warn "read a churned token out of."
    note "The likely cause is that the revoke did not go through: denyAppRemoval"
    note "stops exactly this, and C6 observed it holding."
    X3_SCREEN=""; REINSTALL_AT=""
  fi
fi
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "X4 · Is an unresolvable token detectable at all?"
budget
say "The check that can delete a code path. If a token that stopped resolving is"
say "indistinguishable from one that still does, the whole degradation path is"
say "unreachable and nothing should be built to detect it."
say ""
say "Two readings, because the count alone cannot fail: a full count is equally"
say "consistent with nothing having churned and with everything having churned"
say "invisibly. Only the shield tells those apart."
say ""
if [[ ! "${X3_DELETED:-}" =~ ^[Yy] ]]; then
  say "Skipped: nothing was reinstalled, so no token was given the chance to churn."
  X4_SHIELD=""
elif check_open X4; then
  step "Open the app you blocked."
  say ""
  say "What appeared?"
  note "  a  a dark shield instead of the app"
  note "  b  nothing: the app opened normally"
  observe X4_SHIELD "a / b:"
  note "The count itself is read from the archive, not from you. What the screen"
  note "claims and what the shield does are the two halves of this row."
fi
pause

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "X5 · The deadline, the history row, and the clean slate"
say "Wait it out. Do not open the app."
say ""
warn "Leave freedomfrom closed until this wizard says otherwise."
note "The app reconciles on every launch and every foreground. If it is open"
note "when the deadline passes, the app takes the release and the question of"
note "whether one arrives on its own goes unasked."
say ""
if [[ -n "${DEADLINE_AT:-}" ]]; then
  wait_until "$DEADLINE_AT"
else
  pause "Press Enter once ${X_DEADLINE:-the deadline} has passed."
fi
say ""
note "Late is the accepted direction and early is not, so give it a moment."
say ""
step "Open freedomfrom, and go to the history line."
say "What does the row for this commitment read?"
note "  a  broken"
note "  b  completed"
note "  c  there is no row"
observe X5_HISTORY "a / b / c:"
say ""
note "Either of the first two is the expected answer while #54 stands. The"
note "commitment really was broken, and it would read broken had nobody touched"
note "it, so this half is recorded rather than scored."
say ""
step "Now run a clean slate, and answer for what it left behind."
observe X5_HISTORY_GONE "Is the history empty afterwards? (y/n)"
observe X5_DRAFT_GONE "Are the typed domains and the chosen length gone too? (y/n)"
observe X5_FIRSTRUN "Did it send you back to first run — 'Begin'? (y/n)"
note "The last one should be no. Clean slate erases what you authored and"
note "deliberately leaves first run consumed (ADR 0008), which is also why C1"
note "cannot be re-walked on this phone."
pause

# ── 10 ────────────────────────────────────────────────────────────────────
stage "X6 · Capture"
say "One capture for the whole run, not one per check."
say ""
warn "log collect is root-gated, so a person runs this line. It is not run here,"
warn "and the password does not enter this session."
say ""
note "  ssh $HOST"
note "  mkdir -p ~/$MAC_EVIDENCE"
note "  sudo log collect --device-udid $DEVICE_UDID --last $(( LENGTH_MINUTES + 30 ))m \\"
note "    --output ~/$MAC_EVIDENCE/x1-x5.logarchive"
note "  sudo chown -R \"\$(whoami)\" ~/$MAC_EVIDENCE/x1-x5.logarchive"
say ""
note "It has to reach back past the commit, not just the release."
pause "Collected?"

say "Reading it back, filtered to $SUBSYSTEM…"
if remote_sh <<EOF > "$EVIDENCE/x1-x5.log" 2>/dev/null
log show --archive "$ARCHIVE" \\
  --predicate 'subsystem == "$SUBSYSTEM"' \\
  --info --debug --style compact
EOF
then
  lines=$(grep -c . "$EVIDENCE/x1-x5.log" || true)
  printf '  %s✓%s %s line(s) → docs/evidence/x1-x5.log\n' "$GREEN" "$RESET" "$lines"
  if [[ "$lines" -eq 0 ]]; then
    warn "The archive holds no lines from this subsystem."
    note "Check the phone is running a current build, and that the window reached"
    note "back far enough to cover the commit."
  fi
else
  warn "could not read the archive. Check the path and the chown line above."
  SKIPPED+=("re-read the archive into docs/evidence/x1-x5.log")
fi
pause

# ── 11 ────────────────────────────────────────────────────────────────────
stage "The verdicts"

app=$(log_for app)
monitor=$(log_for monitor)
shieldconfig=$(log_for shieldconfig)
printf '%s\n' "$app" > "$EVIDENCE/x1-x5-app.log"
printf '%s\n' "$monitor" > "$EVIDENCE/x1-x5-monitor.log"
printf '%s\n' "$shieldconfig" > "$EVIDENCE/x1-x5-shieldconfig.log"
everything="$app$monitor$shieldconfig"

# Before anything is scored. A build with a way out of a commitment is not the
# product, and a run walked on one is not this run.
if grep -q "woke reason=hardware-pass build" <<<"$app"; then
  warn "STOP — the archive says this was a hardware-pass build."
  say "That build compiles in a release control, which the product does not have."
  say "Nothing observed under it is a fact about what ships, so no row is written."
  say ""
  say "Install a clean build — scripts/mac device, with no FREEDOMFROM_HARDWARE_PASS"
  say "in the environment — and walk the run again."
  finish
  exit 1
fi

# Everything below is scoped to this commitment where a stamp exists for it. On
# a resumed run there is no commit stamp, and scoping to nothing is the honest
# answer: the counts then cover the archive and X1c says so rather than
# counting an earlier commitment's mark against this one.
if [[ -n "${COMMIT_AT:-}" ]]; then
  run_app=$(since "$COMMIT_AT" <<<"$app")
  run_all=$(since "$COMMIT_AT" <<<"$everything")
  SCOPED=yes
else
  run_app="$app"
  run_all="$everything"
  SCOPED=no
fi

MARKS=$(grep -c "marked broken" <<<"$run_all" || true)
MARK_AT=$(first_epoch "marked broken" <<<"$run_all" || true)

# One deadline, or more than one. A break must never move it, and this is the
# same fact X1 and X3 both need, parsed once.
DEADLINES=$(grep -o "deadline [0-9TZ:-]*" <<<"$run_all" | sort -u | grep -c . || true)

# The settled read after the revoke. A foreground is a process that has been
# alive; a launch is the unsettled one #54 is about.
AUTH_AFTER_REVOKE=""
AUTH_SETTLED=no
if [[ -n "${REVOKE_AT:-}" ]]; then
  post_revoke=$(since "$REVOKE_AT" <<<"$app")
  AUTH_AFTER_REVOKE=$(auth_reads <<<"$post_revoke" | grep '^foreground ' | head -n1 | cut -d' ' -f2-)
  if [[ -n "$AUTH_AFTER_REVOKE" ]]; then
    AUTH_SETTLED=yes
  else
    AUTH_AFTER_REVOKE=$(auth_reads <<<"$post_revoke" | head -n1 | cut -d' ' -f2-)
  fi
fi

# The same pairing across the whole run, which is what corroborates #54 on
# hardware: a launch and a foreground minutes apart disagreeing about the state.
LAUNCH_STATES=$(auth_reads <<<"$run_app" | grep '^launch ' | cut -d' ' -f2- | sort -u | paste -sd'/' -)
FGROUND_STATES=$(auth_reads <<<"$run_app" | grep '^foreground ' | cut -d' ' -f2- | sort -u | paste -sd'/' -)

# After the reinstall: did it find the commitment, and did it re-arm?
REARM_ACTIVE=no; REARM_ENFORCED=no; X4_RESOLVED=""; X4_NAMED=""
if [[ -n "${REINSTALL_AT:-}" ]]; then
  post_reinstall=$(since "$REINSTALL_AT" <<<"$everything")
  grep -q "record read found=true active=true" <<<"$post_reinstall" && REARM_ACTIVE=yes
  grep -q "store mutation enforcement landed=true" <<<"$post_reinstall" && REARM_ENFORCED=yes
  x4cov=$(grep -o "coverage resolved=[0-9]* of named=[0-9]*" <<<"$post_reinstall" | tail -n1)
  X4_RESOLVED=$(grep -o "resolved=[0-9]*" <<<"$x4cov" | cut -d= -f2)
  X4_NAMED=$(grep -o "named=[0-9]*" <<<"$x4cov" | cut -d= -f2)
fi

released=no; grep -q "released late_by_seconds=" <<<"$run_all" && released=yes
late_by=$(grep -o "late_by_seconds=[0-9]*" <<<"$run_all" | tail -n1 | cut -d= -f2)

note "scoped to this commitment:  $SCOPED"
note "marked broken, times:       $MARKS"
note "distinct deadlines:         $DEADLINES"
note "authorization at launch:    ${LAUNCH_STATES:-none}"
note "authorization at foreground: ${FGROUND_STATES:-none}"
note "after the revoke:           ${AUTH_AFTER_REVOKE:-none} (settled: $AUTH_SETTLED)"
note "re-armed after reinstall:   active=$REARM_ACTIVE enforcement=$REARM_ENFORCED"
note "coverage after reinstall:   ${X4_RESOLVED:-?} of ${X4_NAMED:-?}"
note "release logged:             $released${late_by:+, late by ${late_by}s}"
say ""
pause

# >>> verdicts begin — everything to the matching marker is pure: it reads the
# answers and the parsed log facts, and calls record_result and amend_adr. No
# prompts, no ssh, no clock. scripts/test-x1-x5-verdicts extracts exactly this
# span and drives it, so the chain is exercised without a phone. Keep it pure.

# ── X1 ────────────────────────────────────────────────────────────────────
# Three observations rather than a verdict, and the first is the one the run is
# worth walking for. What a revoke leaves the status as is the fact #54's fix
# turns on, and nothing in the repo can answer it without a phone.
#
# No ADR amendment is bound to any outcome here. ADR 0005 says a break marks a
# running commitment and does not end one, and every branch below leaves that
# standing. What a bad result produces is a bug, and the bug already has a
# number.
if was_expired X1; then
  expired_note X1
elif [[ ! "${X1_RUNNING_BEFORE:-}" =~ ^[Yy] ]]; then
  # Nothing to break. Everything below this row assumes a commitment was
  # running when the revoke happened, and a run that started without one is
  # asking every later question of a phone in a different state.
  record_result X1 "Inconclusive, re-run" \
    "No countdown was running before the revoke, so there was no commitment for any of this to be observed against" \
    "None — not a result"
  FOLLOWUP+=("X1: the run began with nothing running, so no row in Phase 3 is about a live commitment")
elif [[ -z "$AUTH_AFTER_REVOKE" ]]; then
  record_result X1 "Inconclusive, re-run" \
    "No \`authorization state=\` line landed after the revoke was stamped, so what a revoke reads as was not observed. The app has to be brought to the foreground after the revoke for there to be anything to read" \
    "None — not a result"
  FOLLOWUP+=("X1 produced no post-revoke authorization read, which is the one fact #54 is waiting on")
elif [[ "$AUTH_SETTLED" == no ]]; then
  # A launch-time read cannot answer this: it is the unsettled one by
  # construction, so `Not Determined` here would mean either "a revoke reads as
  # that" or "the process was young", and #54 is precisely the inability to
  # tell those apart.
  record_result X1 "Inconclusive, re-run" \
    "The only authorization read after the revoke came from a cold launch (\`$AUTH_AFTER_REVOKE\`), which is the unsettled read #54 is about. It cannot distinguish a revoked state from a young process, so it does not answer what a revoke leaves behind" \
    "None — not a result"
  FOLLOWUP+=("X1a needs a foreground read after the revoke, not a launch. Re-walk without killing the app")
elif (( DEADLINES > 1 )); then
  # This outranks everything else in the row. A break that moves a deadline is
  # ADR 0002's absolute deadline failing, which is the load-bearing claim of the
  # whole design.
  record_result X1 "**Red**" \
    "The archive holds $DEADLINES different deadlines for this commitment, so something moved it. A break marks a commitment and must never shorten one (ADR 0005), and the deadline is absolute and authoritative (ADR 0002)" \
    "None bound — a deadline that moves is not a decision to amend, it is the one thing the design does not survive"
  FOLLOWUP+=("X1 red: the deadline moved during the run. Nothing else in this table matters until that is explained")
else
  arity="the archive holds $MARKS \`marked broken\` line(s) for it"
  case "$MARKS" in
    1) arity="it was marked broken exactly once across every launch and foreground in the run" ;;
    0) arity="it was never marked broken at all, which no branch of the app explains while a revoke and a reinstall both happened" ;;
  esac

  when="when the mark landed relative to the revoke was not established"
  if [[ -n "$MARK_AT" && -n "${REVOKE_AT:-}" ]]; then
    if (( MARK_AT < REVOKE_AT )); then
      when="**the commitment was already marked before the revoke**, which is #54 confirmed on hardware rather than inferred from a log read afterwards"
    else
      when="the mark landed after the revoke, so on this run the two cannot be told apart"
    fi
  fi

  contrast=""
  [[ -n "$LAUNCH_STATES" && -n "$FGROUND_STATES" && "$LAUNCH_STATES" != "$FGROUND_STATES" ]] &&
    contrast=". Launches read \`$LAUNCH_STATES\` and foregrounds read \`$FGROUND_STATES\` in the same run, which is #54's mechanism in one line"

  if [[ "$MARKS" == 1 && "${X1_RUNNING_AFTER:-}" =~ ^[Yy] ]]; then
    record_result X1 "**Green**, and \`$AUTH_AFTER_REVOKE\` after a revoke" \
      "A settled foreground read after the revoke says \`authorization state=$AUTH_AFTER_REVOKE\`$contrast. The countdown was still running afterwards and the deadline never moved, and $arity. On the mark's cause: $when" \
      "None bound — every result here leaves ADR 0005 standing. **What it decides is #54**: a revoke reading \`$AUTH_AFTER_REVOKE\` is what tells that fix which state may carry the break signal"
  else
    detail="A settled foreground read after the revoke says \`authorization state=$AUTH_AFTER_REVOKE\`$contrast, and $arity"
    [[ ! "${X1_RUNNING_AFTER:-}" =~ ^[Yy] ]] && detail="$detail. The countdown was **not** still running afterwards, though the deadline in the archive never changed — so the screen and the record disagree"
    record_result X1 "Inconclusive, re-run" "$detail. On the mark's cause: $when" \
      "None — not a result, though the post-revoke read stands on its own and is what #54 needs"
    FOLLOWUP+=("X1: the post-revoke state reads $AUTH_AFTER_REVOKE. Take that to #54 even though the row is not green")
  fi
fi

# ── X2 ────────────────────────────────────────────────────────────────────
# Pre-decided either way by ADR 0005, so this row records rather than judges.
if was_expired X2; then
  expired_note X2
elif [[ "${X2_PROMPT:-}" =~ ^[Yy] && "${X2_GRANTED:-}" =~ ^[Yy] ]]; then
  regained=""
  [[ "$REARM_ENFORCED" == yes ]] && regained=", and enforcement was applied again afterwards"
  record_result X2 "**Green**" \
    "iOS prompted for Screen Time access on the first foreground after the revoke, and granting it re-armed coverage$regained" \
    "None"
elif [[ "${X2_PROMPT:-}" =~ ^[Yy] ]]; then
  record_result X2 "**Green**, prompt only" \
    "iOS prompted for Screen Time access after the revoke. It was not granted, so whether granting re-arms coverage went unobserved on this run" \
    "None"
  FOLLOWUP+=("X2: the prompt appeared but was not granted, so the re-arm half is unobserved")
else
  record_result X2 "**Red**, and pre-decided" \
    "No prompt appeared on the first foreground after the revoke, so a revoked authorization cannot be re-requested from inside the app" \
    "None needed. ADR 0005 pre-decided this: it degrades into the never-ask option at the cost of one wasted \`requestAuthorization\` per launch, and the app already accepts a refusal in silence"
fi

# ── X3 ────────────────────────────────────────────────────────────────────
# The record outliving deletion, which is the foundation ADR 0002 puts
# everything else on. That the reinstall also marks the commitment broken proves
# nothing while #54 stands: the marker file is gone and the status is unsettled,
# so two sufficient causes fire at once and neither can be told from the other.
if was_expired X3; then
  expired_note X3
elif [[ ! "${X3_DELETED:-}" =~ ^[Yy] ]]; then
  record_result X3 "Not reached" \
    "The app would not delete, so there was no reinstall to observe. \`denyAppRemoval\` stops exactly this, and C6 observed it holding — so the likely cause is that the revoke at X1 did not go through" \
    "None — not a result"
  FOLLOWUP+=("X3 not reached: the app would not delete. Check the revoke actually landed before re-running")
elif [[ "$REARM_ACTIVE" == yes && "$X3_SCREEN" == a && "$DEADLINES" == 1 ]]; then
  enforced=""
  [[ "$REARM_ENFORCED" == yes ]] && enforced=", and \`store mutation enforcement landed=true\` follows it"
  record_result X3 "**Green**" \
    "A reinstalled app read the record and found the commitment still running — \`record read found=true active=true\`$enforced — and landed on the countdown with no comment. The deadline is the same one throughout the archive. The Keychain record outliving deletion is what ADR 0002 rests on, and this is the only check that exercises it" \
    "None"
elif [[ "$REARM_ACTIVE" == no ]]; then
  record_result X3 "**Red**" \
    "After the reinstall the app did not read a running commitment out of the Keychain$([[ "$X3_SCREEN" == b ]] && echo ", and landed on first run")$([[ "$X3_SCREEN" == c ]] && echo ", and landed on Targets"). The record did not survive deletion" \
    "None bound — the Keychain record outliving app deletion is ADR 0002's premise rather than one of its options, and a red here reopens the data model instead of amending it"
  FOLLOWUP+=("X3 red: the record did not survive deletion. ADR 0002's whole data model needs re-opening")
else
  detail="\`record read found=true active=true\` is in the archive after the reinstall"
  [[ "$X3_SCREEN" != a ]] && detail="$detail, but the app did not land on a countdown"
  (( DEADLINES > 1 )) && detail="$detail, and the archive holds $DEADLINES different deadlines, so something moved it"
  record_result X3 "Inconclusive, re-run" "$detail" "None — not a result"
fi

# ── X4 ────────────────────────────────────────────────────────────────────
# The check that can delete a code path, and the only one whose red needs two
# readings to be reachable at all. A full count is equally consistent with
# nothing having churned and with everything having churned invisibly; only the
# shield separates them.
if was_expired X4; then
  expired_note X4
elif [[ ! "${X3_DELETED:-}" =~ ^[Yy] ]]; then
  record_result X4 "Not reached" \
    "Nothing was reinstalled, so no token was given the chance to churn" \
    "None — not a result"
elif [[ -z "$X4_RESOLVED" || -z "$X4_NAMED" ]]; then
  record_result X4 "Inconclusive, re-run" \
    "No \`coverage resolved= of named=\` line landed after the reinstall, so there is no count to read against the shield" \
    "None — not a result"
elif [[ "$REARM_ENFORCED" == no ]]; then
  # Nothing was applied, so the shield's absence says nothing about tokens.
  # Usually this is X2 red: an unauthorized phone enforces nothing.
  record_result X4 "Inconclusive, re-run" \
    "Coverage read \`$X4_RESOLVED of $X4_NAMED\` after the reinstall, but enforcement was never applied$([[ ! "${X2_PROMPT:-}" =~ ^[Yy] ]] && echo " — X2 found no way to re-authorize, and an unauthorized phone shields nothing"), so an absent shield is not evidence about tokens" \
    "None — not a result"
elif (( X4_RESOLVED < X4_NAMED )); then
  record_result X4 "**Green**" \
    "The countdown read \`${X1_COVERAGE_BEFORE:-not read}\` before any of this, and coverage read \`$X4_RESOLVED of $X4_NAMED\` after the reinstall — so at least one token stopped resolving across it and the app noticed, by minting and comparing. Degradation is reachable, and ADR 0005's degraded row means something" \
    "None"
elif [[ "$X4_SHIELD" == a ]]; then
  record_result X4 "Inconclusive, re-run" \
    "The countdown read \`${X1_COVERAGE_BEFORE:-not read}\` before any of this, coverage read \`$X4_RESOLVED of $X4_NAMED\` after the reinstall, and the shield was still up — so nothing churned. This run produced no unresolvable token, and says nothing about whether one would be detected, which is a re-run and not a red" \
    "None — not a result"
  FOLLOWUP+=("X4 inconclusive: tokens survived the reinstall, so detectability is still unobserved")
else
  printf '  %s✗ RED%s — the count did not notice. The gate fires.\n' "$RED" "$RESET"
  record_result X4 "**Red**" \
    "Coverage read \`$X4_RESOLVED of $X4_NAMED\` after the reinstall — full — while the blocked app opened with no shield, and enforcement had been applied. The token stopped resolving and the count did not notice, which is the only shape in which undetectability is observable" \
    "**Fired.** [ADR 0005](./adr/0005-what-v1-does-when-things-go-wrong.md) amended: degradation is unobservable"

  amend_adr "0005-what-v1-does-when-things-go-wrong.md" \
    "## Amended by hardware: degradation is unobservable" <<'ADR0005'
> Hardware smoke check X4 came back **red**. After a delete and reinstall the
> app's coverage line read a full count while the blocked app opened with no
> shield, and `store mutation enforcement landed=true` is in the archive. A
> token that had stopped resolving minted the same handle as one that still
> did, so the comparison coverage is built on cannot see the difference.

**Degradation leaves v1 as an observable state.** Coverage states the named
count, because that is the only number the app can honestly produce. The
`isDegraded` mark and the `completedDegraded` outcome stay in the record and in
the history's vocabulary — removing them would rewrite stored rows — but nothing
sets them, and the history's three words become two in practice.

This deletes rather than replaces. There is no second mechanism to reach for:
application tokens are opaque by design, the app never learns what they name
(ADR 0006), and an enforcement read-back does not exist anywhere in
`ManagedSettings`. **Nothing is built to detect what cannot be detected**, and
the countdown says the honest number rather than a number with a caveat.

Two things follow. ADR 0008's "a commitment can no longer be degraded at birth"
becomes moot — it was already true after apps left the draft, and now there is
no birth defect to have. And the countdown's coverage line stops being the
substitute for a message the app refuses to show, because it no longer varies:
what it states is what was named, which the user already knows.
ADR0005
fi

# ── X5 ────────────────────────────────────────────────────────────────────
# The clean slate is what this row is for. The history half is recorded and not
# scored: the row will read broken, and this commitment really was broken, but
# it would read broken had nobody touched it (#54).
history_note="The history row read $(case "${X5_HISTORY:-}" in a) echo broken ;; b) echo completed ;; *) echo "as having no row" ;; esac), which is recorded rather than scored: while #54 stands a commitment reads broken whether or not anything broke it"

if [[ "${X5_HISTORY:-}" == c ]]; then
  record_result X5 "**Red**" \
    "No history row was written for a commitment that reached its deadline. A release files a row (ADR 0005), and a release with no row is the history losing the only account of a commitment there is" \
    "None bound — the history is where a commitment goes when it ends, and a release that files nothing is a bug rather than a decision"
  FOLLOWUP+=("X5 red: a commitment reached its deadline and no history row was written")
elif [[ "$released" == no ]]; then
  record_result X5 "Inconclusive, re-run" \
    "No \`released late_by_seconds=\` line is in the archive, so the commitment was not observed reaching its deadline and what followed is not about a release" \
    "None — not a result"
  FOLLOWUP+=("X5: no release was logged. The capture window may not have reached the deadline")
elif [[ "${X5_HISTORY_GONE:-}" =~ ^[Yy] && "${X5_DRAFT_GONE:-}" =~ ^[Yy] && ! "${X5_FIRSTRUN:-}" =~ ^[Yy] ]]; then
  record_result X5 "**Green**" \
    "The clean slate erased the history and the draft together and left first run consumed, on the longest hold in the app. \`released late_by_seconds=$late_by\` in the archive. $history_note" \
    "None"
elif [[ "${X5_FIRSTRUN:-}" =~ ^[Yy] ]]; then
  record_result X5 "**Red**" \
    "The clean slate sent the app back to first run. ADR 0008 has it erase what you authored and leave first run consumed, and a clean slate that resets it hands the consent sentence back to somebody who has already read it — and makes it the only route to a screen C1 says has none. $history_note" \
    "None bound — ADR 0008 decided what a clean slate takes, and taking more than that is a bug against the decision rather than a case for changing it"
  FOLLOWUP+=("X5 red: clean slate reset hasSeenFirstRun, which ADR 0008 says it must not")
else
  kept="the history"
  [[ "${X5_HISTORY_GONE:-}" =~ ^[Yy] ]] && kept="the draft"
  record_result X5 "**Red**" \
    "The clean slate left $kept behind. It erases everything you authored, and a partial one leaves the app holding a record of commitments its owner asked it to forget. $history_note" \
    "None bound — ADR 0008 fixed what a clean slate takes, and leaving half of it is a bug against that decision"
  FOLLOWUP+=("X5 red: clean slate did not erase everything ADR 0008 says it takes")
fi

# <<< verdicts end

pause

# ── 12 ────────────────────────────────────────────────────────────────────
stage "What this run produced"
say "Results table rows written into docs/hardware-smoke-checklist.md:"
for r in "${RECORDED[@]}"; do note "  $r"; done
say ""
if (( ${#AMENDED[@]} )); then
  say "ADRs amended in place:"
  for a in "${AMENDED[@]}"; do note "  $a"; done
else
  note "No amendment fired."
fi
say ""
if [[ -n "$AUTH_AFTER_REVOKE" && "$AUTH_SETTLED" == yes ]]; then
  say "The fact this run existed to get:"
  printf '  %s→%s a revoke leaves authorizationStatus reading %s%s%s\n' \
    "$GREEN" "$RESET" "$BOLD" "$AUTH_AFTER_REVOKE" "$RESET"
  note "  That is what #54 is waiting on. Put it on the issue before anything else."
  say ""
fi
if (( ${#FOLLOWUP[@]} )); then
  say "Work this run created, which nothing here has filed:"
  for f in "${FOLLOWUP[@]}"; do note "  - $f"; done
  note "Each one wants an issue on the v1 milestone. Read the rows before filing:"
  note "  gh issue create --milestone v1 --label ready-for-agent"
  say ""
fi
say "Evidence saved beside the checklist:"
note "  docs/evidence/x1-x5.log               every line from this subsystem"
note "  docs/evidence/x1-x5-app.log           the app"
note "  docs/evidence/x1-x5-monitor.log       the watchdog"
note "  docs/evidence/x1-x5-shieldconfig.log  the extension that draws the shield"
note "  docs/evidence/answers-x1-x5.env       what you reported seeing"
note "The .logarchive itself stays on $HOST at ~/$MAC_EVIDENCE, being far too large to commit."
say ""
say "Review the diff before committing it. Nothing here is worth more than its evidence."

finish
