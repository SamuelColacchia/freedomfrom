# Agent runtime artifacts — machine-local, never committed
.codegraph
.omo/

# Generated by xcodegen from project.yml on every build (issue #4, ADR 0010)
*.xcodeproj

# Build output. The real caches live on the Mac at ~/builds/freedomfrom, outside
# the rsync mirror; these catch anything a stray local run leaves behind.
.build/
DerivedData/
*.xcarchive

# Raw per-run output of the #80 filter-capacity probe: screenshots and UI trees
probes/filter-capacity/results/

# Dropped here by wrangler every time a pr-walkthrough is published
.wrangler/

# The app-categories prototype's fetched App Store data and the page built from
# it. They carry Apple's listing text, which this public repo must not
# republish; `bun prototypes/app-categories/fetch.ts` regenerates both.
prototypes/app-categories/raw-data.json
prototypes/app-categories/index.html
